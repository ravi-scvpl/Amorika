{% comment %}
  Brand Philosophy Section (Exact Match preview.html)
{% endcomment %}

<section class="philosophy reveal">
  <div class="wrap">
    <div class="rule"></div>
    <blockquote>
      {{ section.settings.quote_before | default: "We don't sell hampers. We curate " }}<em>{{ section.settings.quote_em | default: "moments." }}</em>
    </blockquote>
    <p style="font-size: 15.5px; color: var(--taupe); max-width: 520px; margin: 0 auto; line-height: 1.7;">
      {{ section.settings.subtitle | default: "Every element is chosen for how it feels, smells, sounds, and stays." }}
    </p>
    <div class="rule-bottom"></div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Philosophy",
  "settings": [
    {
      "type": "text",
      "id": "quote_before",
      "label": "Quote Text Before Accent",
      "default": "We don't sell hampers. We curate "
    },
    {
      "type": "text",
      "id": "quote_em",
      "label": "Accented Word",
      "default": "moments."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Every element is chosen for how it feels, smells, sounds, and stays."
    }
  ],
  "presets": [
    {
      "name": "Brand Philosophy"
    }
  ]
}
{% endschema %}
