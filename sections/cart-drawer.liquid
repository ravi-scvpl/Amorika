{% comment %}
  Cart Drawer Section - Moments By Amoraki
  Slide-out AJAX cart drawer with luxury item list, subtotal & checkout
{% endcomment %}

<div class="cart-overlay" id="CartOverlay"></div>

<aside class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-label="Your Moment Hamper">
  <div class="cart-drawer__header">
    <div>
      <h3 class="cart-drawer__title" style="margin-bottom: 2px;">Your Moment Hamper</h3>
      <p style="font-size: 13px; color: var(--taupe); margin: 0;">A few details, and your moment is on its way.</p>
    </div>
    <button type="button" class="cart-drawer__close js-close-cart" aria-label="Close Cart">
      {% render 'icon-close', size: 20 %}
    </button>
  </div>

  <div class="cart-drawer__items" id="CartDrawerItems">
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="cart-drawer__item" data-line="{{ forloop.index }}">
          <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="cart-drawer__item-img" />
          <div>
            <h4 class="cart-drawer__item-title">{{ item.product.title }}</h4>
            <span style="display: block; font-size: 12px; color: var(--taupe);">Collection: Moment of Care</span>
            <div class="cart-drawer__item-price">{{ item.final_price | money }}</div>
            <div class="cart-drawer__item-qty">
              <button type="button" class="cart-drawer__qty-btn js-qty-minus">-</button>
              <span class="cart-drawer__qty-val">{{ item.quantity }}</span>
              <button type="button" class="cart-drawer__qty-btn js-qty-plus">+</button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Demo Item matching Moment of Care -->
      <div class="cart-drawer__item">
        <img src="{{ 'moment-of-care.jpg' | asset_url }}" alt="Moment of Care Hamper" class="cart-drawer__item-img" />
        <div>
          <h4 class="cart-drawer__item-title">Moment of Care</h4>
          <span style="display: block; font-size: 12px; color: var(--taupe);">Collection: Moment of Care</span>
          <div class="cart-drawer__item-price">₹5,490 <span style="font-size: 11px; color: var(--taupe);">(incl. taxes)</span></div>
          <div class="cart-drawer__item-qty">
            <button type="button" class="cart-drawer__qty-btn">-</button>
            <span class="cart-drawer__qty-val">1</span>
            <button type="button" class="cart-drawer__qty-btn">+</button>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="cart-drawer__footer">
    <div style="font-size: 13px; color: var(--ink); border-bottom: 1px solid var(--line); padding-bottom: 12px; margin-bottom: 12px;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
        <span>Hamper Price (incl. taxes):</span>
        <span>₹5,490</span>
      </div>
      <div style="display: flex; justify-content: space-between; color: var(--taupe);">
        <span>Hand delivery fee (Delhi NCR):</span>
        <span>+ ₹200</span>
      </div>
    </div>
    <div class="cart-drawer__subtotal" style="font-weight: 600;">
      <span>Total amount</span>
      <span id="CartSubtotal">{{ cart.total_price | money | default: '₹5,690' }}</span>
    </div>
    <a href="/checkout" class="btn btn--primary" style="width: 100%; margin-top: 12px; text-transform: uppercase; letter-spacing: 0.08em;">
      Continue to pay &rarr;
    </a>
  </div>
</aside>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
