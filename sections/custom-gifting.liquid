{% comment %}
  Custom Gifting / Bespoke Curation Section (Exact Match preview.html)
{% endcomment %}

<section class="custom reveal" id="custom-gifting">
  <div class="wrap">
    <div class="bespoke-grid">
      <div class="bespoke-left">
        <div class="bespoke-left-text">
          <span class="tag tag--dark">Bespoke</span>
          <h2>{{ section.settings.title | default: 'Custom & Corporate Curation' }}</h2>
          <p>{{ section.settings.subtitle | default: 'Weddings, corporate milestones, or private celebrations. We work directly with you to craft hampers aligned with your aesthetic and intention.' }}</p>
          <a href="#" class="link-plus js-open-custom-form">Enquire for Custom Order &rarr;</a>
        </div>
        <div class="bespoke-img">
          <img class="bespoke-img-tag"
            src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?q=80&w=600&auto=format&fit=crop"
            alt="Custom wrapped gift box with silk ribbon">
        </div>
      </div>

      <div class="bespoke-right">
        <div class="bespoke-lock">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        <p>Personalized wax seals, custom branded stationery, & hand-selected artisanal elements.</p>
        <a href="#" class="btn btn--ink js-open-custom-form">Request Curation Catalogue &rarr;</a>
        <p class="bespoke-moq">Minimum order quantity for custom curation: 15 hampers</p>
      </div>
    </div>

    <!-- Collapsible Form -->
    <div class="collapse" id="customFormWrap">
      <form class="form" id="customForm">
        <div class="field">
          <label for="cf-name">Your Name</label>
          <input type="text" id="cf-name" required placeholder="Full Name">
        </div>
        <div class="field">
          <label for="cf-contact">Phone / WhatsApp</label>
          <input type="text" id="cf-contact" required placeholder="+91 99999 99999">
        </div>
        <div class="field">
          <label for="cf-qty">Estimated Quantity</label>
          <input type="number" id="cf-qty" placeholder="e.g. 25 hampers" min="1">
        </div>
        <div class="field">
          <label for="cf-moment">Tell Us About the Occasion</label>
          <textarea id="cf-moment" placeholder="Wedding, corporate retreat, festival gifting..."></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Submit Order Enquiry &rarr;</button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Gifting",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Custom & Corporate Curation"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Weddings, corporate milestones, or private celebrations. We work directly with you to craft hampers aligned with your aesthetic and intention."
    }
  ],
  "presets": [
    {
      "name": "Custom Gifting"
    }
  ]
}
{% endschema %}
