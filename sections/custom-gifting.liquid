{% comment %}
  Custom Gifting / Bespoke Curation Section
  Fully customizable via Shopify Customizer with image_picker & text options.
{% endcomment %}

<section class="custom" id="custom-gifting">
  <div class="wrap">
    <div class="bespoke-grid reveal">
      <div class="bespoke-left">
        <div class="bespoke-left-text">
          <h2>{{ section.settings.title | default: 'Bespoke Gifting' }}</h2>
          <p>{{ section.settings.subtitle | default: 'Designed around your intent, never from a catalogue.' }}</p>
          <a href="#" class="link-arrow js-open-custom-form">{{ section.settings.form_link_text | default: 'Start a Conversation' }} &rarr;</a>
        </div>
        <div class="bespoke-img">
          {% if section.settings.bespoke_image != blank %}
            <img class="bespoke-img-tag"
              src="{{ section.settings.bespoke_image | image_url: width: 600 }}"
              alt="{{ section.settings.bespoke_image.alt | default: section.settings.title }}">
          {% else %}
            <img class="bespoke-img-tag"
              src="{{ 'custom-gifting.jpg' | asset_url }}"
              alt="The brass singing bowl and mallet resting on slate beside smooth stones">
          {% endif %}
        </div>
      </div>

      <div class="bespoke-right">
        <svg class="bespoke-lock" viewBox="0 0 34 34" fill="none">
          <rect x="8" y="15" width="18" height="14" rx="1.5" stroke="currentColor" stroke-width="1.3" />
          <path d="M12 15v-4a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="1.3" />
        </svg>
        <p>{{ section.settings.right_text | default: "Tell us a little about what you're looking to create.<br>We'll be in touch to bring it to life." }}</p>
        <a href="#" class="link-plus js-open-custom-form">{{ section.settings.catalogue_btn_text | default: 'Share your requirements +' }}</a>

        <!-- Collapsible Form Positioned Directly Under the Button -->
        <div class="collapse" id="customFormWrap">
          <form class="form reveal" id="customForm" data-whatsapp="{{ section.settings.whatsapp_number | default: '917827961165' }}">
            <div class="field">
              <label for="cf-name">Name</label>
              <input type="text" id="cf-name" required>
            </div>
            <div class="field">
              <label for="cf-contact">Phone or Email</label>
              <input type="text" id="cf-contact" required>
            </div>
            <div class="field">
              <label for="cf-moment">Tell us about the moment</label>
              <textarea id="cf-moment" required placeholder="Who is this for, and what's the occasion — or the moment?"></textarea>
            </div>
            <div class="field">
              <label for="cf-qty">Approximate Quantity</label>
              <input type="text" id="cf-qty" placeholder="e.g. 1, or 100+">
            </div>
            <button type="submit" class="btn btn--primary">Send on WhatsApp</button>
          </form>
        </div>

        {% if section.settings.moq_note != blank %}
          <p class="bespoke-moq">{{ section.settings.moq_note }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Gifting",
  "settings": [
    {
      "type": "text",
      "id": "section_tag",
      "label": "Section Badge Tag",
      "default": "Bespoke"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Bespoke Gifting"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Designed around your intent, never from a catalogue."
    },
    {
      "type": "text",
      "id": "form_link_text",
      "label": "Form Link Label",
      "default": "Start a Conversation"
    },
    {
      "type": "image_picker",
      "id": "bespoke_image",
      "label": "Bespoke Side Image"
    },
    {
      "type": "textarea",
      "id": "right_text",
      "label": "Right Column Description",
      "default": "Tell us a little about what you're looking to create.<br>We'll be in touch to bring it to life."
    },
    {
      "type": "text",
      "id": "catalogue_btn_text",
      "label": "Catalogue Button Label",
      "default": "Share your requirements +"
    },
    {
      "type": "text",
      "id": "moq_note",
      "label": "MOQ Note",
      "default": "MOQ 100pcs | Lead time – 20–25 working days"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Business Number (with country code)",
      "default": "917827961165"
    }
  ],
  "presets": [
    {
      "name": "Custom Gifting"
    }
  ]
}
{% endschema %}
