{% comment %}
  Custom Gifting / Bespoke Curation Section
  Fully customizable via Shopify Customizer with image_picker & text options.
{% endcomment %}

<section class="custom reveal" id="custom-gifting">
  <div class="wrap">
    <div class="bespoke-grid">
      <div class="bespoke-left">
        <div class="bespoke-left-text">
          {% if section.settings.section_tag != blank %}
            <span class="tag tag--dark">{{ section.settings.section_tag }}</span>
          {% endif %}
          <h2>{{ section.settings.title | default: 'Custom & Corporate Curation' }}</h2>
          {% if section.settings.subtitle != blank %}
            <p>{{ section.settings.subtitle }}</p>
          {% endif %}
          <a href="#" class="link-plus js-open-custom-form">{{ section.settings.form_link_text | default: 'Enquire for Custom Order' }} &rarr;</a>
        </div>
        <div class="bespoke-img">
          {% if section.settings.bespoke_image != blank %}
            <img class="bespoke-img-tag"
              src="{{ section.settings.bespoke_image | image_url: width: 600 }}"
              alt="{{ section.settings.bespoke_image.alt | default: section.settings.title }}">
          {% else %}
            <img class="bespoke-img-tag"
              src="https://images.unsplash.com/photo-1549465220-1a8b9238cd48?q=80&w=600&auto=format&fit=crop"
              alt="Custom wrapped gift box with silk ribbon">
          {% endif %}
        </div>
      </div>

      <div class="bespoke-right">
        <div class="bespoke-lock">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
        {% if section.settings.right_text != blank %}
          <p>{{ section.settings.right_text }}</p>
        {% endif %}
        <a href="#" class="btn btn--ink js-open-custom-form">{{ section.settings.catalogue_btn_text | default: 'Request Curation Catalogue' }} &rarr;</a>
        {% if section.settings.moq_note != blank %}
          <p class="bespoke-moq">{{ section.settings.moq_note }}</p>
        {% endif %}
      </div>
    </div>

    <!-- Collapsible Form -->
    <div class="collapse" id="customFormWrap">
      <form class="form" id="customForm" data-whatsapp="{{ section.settings.whatsapp_number | default: '919999999999' }}">
        <div class="field">
          <label for="cf-name">Your Name</label>
          <input type="text" id="cf-name" required placeholder="Full Name">
        </div>
        <div class="field">
          <label for="cf-contact">Phone / WhatsApp</label>
          <input type="text" id="cf-contact" required placeholder="+91 99999 99999">
        </div>
        <div class="field">
          <label for="cf-qty">Estimated Quantity</label>
          <input type="number" id="cf-qty" placeholder="e.g. 25 hampers" min="1">
        </div>
        <div class="field">
          <label for="cf-moment">Tell Us About the Occasion</label>
          <textarea id="cf-moment" placeholder="Wedding, corporate retreat, festival gifting..."></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Submit Order Enquiry &rarr;</button>
      </form>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Gifting",
  "settings": [
    {
      "type": "text",
      "id": "section_tag",
      "label": "Section Badge Tag",
      "default": "Bespoke"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Custom & Corporate Curation"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Weddings, corporate milestones, or private celebrations. We work directly with you to craft hampers aligned with your aesthetic and intention."
    },
    {
      "type": "text",
      "id": "form_link_text",
      "label": "Form Link Label",
      "default": "Enquire for Custom Order"
    },
    {
      "type": "image_picker",
      "id": "bespoke_image",
      "label": "Bespoke Side Image"
    },
    {
      "type": "textarea",
      "id": "right_text",
      "label": "Right Column Description",
      "default": "Personalized wax seals, custom branded stationery, & hand-selected artisanal elements."
    },
    {
      "type": "text",
      "id": "catalogue_btn_text",
      "label": "Catalogue Button Label",
      "default": "Request Curation Catalogue"
    },
    {
      "type": "text",
      "id": "moq_note",
      "label": "MOQ Note",
      "default": "Minimum order quantity for custom curation: 15 hampers"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Business Number (with country code)",
      "default": "919999999999"
    }
  ],
  "presets": [
    {
      "name": "Custom Gifting"
    }
  ]
}
{% endschema %}
