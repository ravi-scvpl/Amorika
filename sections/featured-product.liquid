{% comment %}
  Moment of Care - Featured Product Section
  Fully customizable via Shopify Customizer with image_picker settings & repeatable blocks for "Inside the Hamper" elements.
{% endcomment %}

<section class="moc reveal" id="moment-of-care">
  <div class="wrap">
    <div class="moc-grid">
      <div class="moc-left">
        {% if section.settings.collection_tag != blank %}
          <div class="eyebrow-row" style="justify-content: flex-start;">
            <span class="tag tag--kauna">{{ section.settings.collection_tag }}</span>
          </div>
        {% endif %}

        <h2>{{ section.settings.title | default: 'Moment of Care' }}</h2>
        
        {% if section.settings.tagline != blank %}
          <span class="moc-tagline">{{ section.settings.tagline }}</span>
        {% endif %}
        
        {% if section.settings.description != blank %}
          <p class="moc-sub">{{ section.settings.description }}</p>
        {% endif %}

        <div class="moc-price-row">
          {% if section.settings.price != blank %}
            <span class="moc-price">&#8377;{{ section.settings.price }}</span>
          {% endif %}
          {% if section.settings.delivery_text != blank %}
            <span class="moc-delivery">{{ section.settings.delivery_text }}</span>
          {% endif %}
        </div>

        {% if section.settings.delivery_note != blank %}
          <p class="moc-delivery-note">{{ section.settings.delivery_note }}</p>
        {% endif %}

        {% if section.settings.cta_label != blank %}
          <div class="moc-links">
            <a href="{{ section.settings.cta_link | default: '#custom-gifting' }}" class="btn btn--primary" style="padding: 14px 28px;">
              {{ section.settings.cta_label }} &rarr;
            </a>
          </div>
        {% endif %}
      </div>

      <div class="moc-right">
        {% if section.settings.featured_image != blank %}
          <img class="moc-right-img"
            src="{{ section.settings.featured_image | image_url: width: 1200 }}"
            alt="{{ section.settings.featured_image.alt | default: section.settings.title }}">
        {% else %}
          <img class="moc-right-img"
            src="https://images.unsplash.com/photo-1602928321679-560b4139c907?q=80&w=1200&auto=format&fit=crop"
            alt="Moment of Care Hamper">
        {% endif %}
      </div>
    </div>

    <!-- Inside the Hamper Carousel (Customizable Blocks) -->
    <div class="inside-block">
      {% if section.settings.carousel_tag != blank %}
        <div class="eyebrow-row" style="justify-content: flex-start;">
          <span class="tag tag--dark">{{ section.settings.carousel_tag }}</span>
        </div>
      {% endif %}
      
      {% if section.settings.carousel_headline != blank %}
        <h3 class="inside-headline">{{ section.settings.carousel_headline }}</h3>
      {% endif %}

      <div class="inside-carousel">
        <button class="carousel-arrow carousel-arrow--prev" aria-label="Previous element">&lsaquo;</button>
        <button class="carousel-arrow carousel-arrow--next" aria-label="Next element">&rsaquo;</button>

        <div class="inside-track" id="insideTrack">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="inside-card" tabindex="0" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <img class="inside-img"
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.title }}">
                {% else %}
                  <img class="inside-img"
                    src="https://images.unsplash.com/photo-1602928321679-560b4139c907?q=80&w=800&auto=format&fit=crop"
                    alt="{{ block.settings.title }}">
                {% endif %}

                <div class="inside-overlay">
                  <span class="inside-title">{{ block.settings.title }}</span>
                  {% if block.settings.subtitle != blank %}
                    <span class="inside-sub">{{ block.settings.subtitle }}</span>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="inside-desc">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <!-- Default Fallback Cards if no blocks added yet -->
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="https://images.unsplash.com/photo-1602928321679-560b4139c907?q=80&w=800&auto=format&fit=crop" alt="Singing Bowl">
              <div class="inside-overlay">
                <span class="inside-title">Singing Bowl</span>
                <span class="inside-sub">Resonant &middot; Grounding &middot; Timeless</span>
                <p class="inside-desc">Shaped through repeated hammering, its deep resonance creates a moment of pause — a gentle invitation towards stillness and coming back to the present.</p>
              </div>
            </div>
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="https://images.unsplash.com/photo-1544816155-12df9643f363?q=80&w=800&auto=format&fit=crop" alt="Hand-Hammered Kansa Cup">
              <div class="inside-overlay">
                <span class="inside-title">Hand-Hammered Kansa Cup</span>
                <span class="inside-sub">Ayurvedic &middot; Artisanal &middot; Warm</span>
                <p class="inside-desc">Forged in traditional bronze alloy, celebrated in Ayurveda for its healing properties. Designed for slow sips of warm tea or botanical infusions.</p>
              </div>
            </div>
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="https://images.unsplash.com/photo-1603006905003-be475563bc59?q=80&w=800&auto=format&fit=crop" alt="Hand-Poured Soy Candle">
              <div class="inside-overlay">
                <span class="inside-title">Hand-Poured Soy Candle</span>
                <span class="inside-sub">Botanical &middot; Calming &middot; Pure</span>
                <p class="inside-desc">Infused with natural essential oils, poured in small batches into a reusable brass vessel. Fills the room with subtle, grounding aromatics.</p>
              </div>
            </div>
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?q=80&w=800&auto=format&fit=crop" alt="Brass Incense Holder">
              <div class="inside-overlay">
                <span class="inside-title">Brass Incense Holder</span>
                <span class="inside-sub">Mindful &middot; Elegant &middot; Ritual</span>
                <p class="inside-desc">Minimalist solid brass holder paired with hand-rolled incense sticks. A daily ritual to clear the mind and mark the transition into rest.</p>
              </div>
            </div>
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="https://images.unsplash.com/photo-1576092768241-dec231879fc3?q=80&w=800&auto=format&fit=crop" alt="Organic Herbal Tea Blend">
              <div class="inside-overlay">
                <span class="inside-title">Organic Herbal Tea Blend</span>
                <span class="inside-sub">Soothe &middot; Nourish &middot; Rest</span>
                <p class="inside-desc">Custom blend of whole-leaf chamomile, dried lavender, and rose petals. Sourced directly from organic Himalayan tea estates.</p>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Product",
  "settings": [
    {
      "type": "text",
      "id": "collection_tag",
      "label": "Collection Badge Tag",
      "default": "Collection 01"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Collection Title",
      "default": "Moment of Care"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Collection Tagline",
      "default": "A GIFT OF STILLNESS & MINDFULNESS"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Paragraph",
      "default": "A slow-living hamper curated to bring quiet luxury and sensory relaxation into daily life."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "4,850"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery Text",
      "default": "Free Delivery across Delhi NCR"
    },
    {
      "type": "textarea",
      "id": "delivery_note",
      "label": "Delivery Note",
      "default": "Hand-wrapped in signature linen box with custom wax seal & personal note."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Order This Moment"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Main Hamper Image"
    },
    {
      "type": "text",
      "id": "carousel_tag",
      "label": "Carousel Badge Tag",
      "default": "Curated Elements"
    },
    {
      "type": "text",
      "id": "carousel_headline",
      "label": "Carousel Headline",
      "default": "Inside the Hamper"
    }
  ],
  "blocks": [
    {
      "type": "inside_item",
      "name": "Inside Element Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Element Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Element Title",
          "default": "Singing Bowl"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sub-tags / Features",
          "default": "Resonant · Grounding · Timeless"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Shaped through repeated hammering, its deep resonance creates a moment of pause."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Product",
      "blocks": [
        {
          "type": "inside_item",
          "settings": {
            "title": "Singing Bowl",
            "subtitle": "Resonant · Grounding · Timeless",
            "description": "Shaped through repeated hammering, its deep resonance creates a moment of pause."
          }
        },
        {
          "type": "inside_item",
          "settings": {
            "title": "Hand-Hammered Kansa Cup",
            "subtitle": "Ayurvedic · Artisanal · Warm",
            "description": "Forged in traditional bronze alloy, celebrated in Ayurveda for its healing properties."
          }
        },
        {
          "type": "inside_item",
          "settings": {
            "title": "Hand-Poured Soy Candle",
            "subtitle": "Botanical · Calming · Pure",
            "description": "Infused with natural essential oils, poured in small batches into a reusable brass vessel."
          }
        }
      ]
    }
  ]
}
{% endschema %}
