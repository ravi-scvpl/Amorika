{% comment %}
  Moment of Care - Featured Product Section
  Fully customizable via Shopify Customizer with image_picker settings & repeatable blocks for "Inside the Hamper" elements.
{% endcomment %}

<section class="moc reveal" id="moment-of-care">
  <div class="wrap">
    <div class="moc-grid">
      <div class="moc-left">
        {% if section.settings.collection_tag != blank %}
          <span class="moc-eyebrow">{{ section.settings.collection_tag }}</span>
        {% endif %}

        <h2>{{ section.settings.title | default: 'Moment of Care' }}</h2>
        
        {% if section.settings.tagline != blank %}
          <span class="moc-tagline">{{ section.settings.tagline }}</span>
        {% endif %}

        {% if section.settings.quote != blank %}
          <p class="moc-line">{{ section.settings.quote }}</p>
        {% endif %}
        
        {% if section.settings.description != blank %}
          <p class="moc-sub">{{ section.settings.description }}</p>
        {% endif %}

        {% comment %} Mobile Image placement (between description and price) {% endcomment %}
        <div class="moc-right moc-slider moc-slider--mobile" id="mocSliderMobile">
          {% if section.settings.featured_image != blank %}
            <img class="moc-right-img moc-slide is-active"
              src="{{ section.settings.featured_image | image_url: width: 1200 }}"
              alt="{{ section.settings.featured_image.alt | default: section.settings.title }}">
          {% else %}
            <img class="moc-right-img moc-slide is-active"
              src="{{ 'moment-of-care.jpg' | asset_url }}"
              alt="Moment of Care Hamper">
          {% endif %}

          {% if section.settings.featured_image_2 != blank %}
            <img class="moc-right-img moc-slide"
              src="{{ section.settings.featured_image_2 | image_url: width: 1200 }}"
              alt="{{ section.settings.featured_image_2.alt | default: section.settings.title }}">
          {% else %}
            <img class="moc-right-img moc-slide"
              src="{{ 'hero-hamper.jpg' | asset_url }}"
              alt="Moment of Care Alternate View">
          {% endif %}
        </div>

        <div class="moc-price-block">
          {% if section.settings.price != blank %}
            <div class="moc-price">
              &#8377;{{ section.settings.price }}<span class="moc-tax-note">* (inclusive of all taxes)</span>
            </div>
          {% endif %}
          {% if section.settings.delivery_text != blank %}
            <div class="moc-delivery">{{ section.settings.delivery_text }}</div>
          {% endif %}
        </div>

        {% if section.settings.delivery_note != blank %}
          <p class="moc-delivery-note">{{ section.settings.delivery_note }}</p>
        {% endif %}

        {% assign featured_prod = section.settings.product %}
        {% if featured_prod != blank %}
          <form action="/cart/add" method="post" class="moc-links-form" id="MocAddToCartForm" target="_top">
            <input type="hidden" name="id" value="{{ featured_prod.selected_or_first_available_variant.id }}">
            <button type="submit" class="btn btn--primary js-send-moment-cta" style="padding: 14px 28px;">
              {{ section.settings.cta_label | default: 'Send a Moment of Care' }} &rarr;
            </button>
          </form>
        {% else %}
          <div class="moc-links">
            <button type="button" class="btn btn--primary js-send-moment-cta" style="padding: 14px 28px;">
              {{ section.settings.cta_label | default: 'Send a Moment of Care' }} &rarr;
            </button>
          </div>
        {% endif %}
      </div>

      {% comment %} Desktop Image placement {% endcomment %}
      <div class="moc-right moc-slider moc-slider--desktop" id="mocSlider">
        {% if section.settings.featured_image != blank %}
          <img class="moc-right-img moc-slide is-active"
            src="{{ section.settings.featured_image | image_url: width: 1200 }}"
            alt="{{ section.settings.featured_image.alt | default: section.settings.title }}">
        {% else %}
          <img class="moc-right-img moc-slide is-active"
            src="{{ 'moment-of-care.jpg' | asset_url }}"
            alt="Moment of Care Hamper">
        {% endif %}

        {% if section.settings.featured_image_2 != blank %}
          <img class="moc-right-img moc-slide"
            src="{{ section.settings.featured_image_2 | image_url: width: 1200 }}"
            alt="{{ section.settings.featured_image_2.alt | default: section.settings.title }}">
        {% else %}
          <img class="moc-right-img moc-slide"
            src="{{ 'hero-hamper.jpg' | asset_url }}"
            alt="Moment of Care Alternate View">
        {% endif %}
      </div>
    </div>

    <!-- Inside the Hamper Carousel (Customizable Blocks) -->
    <div class="inside-block">
      {% if section.settings.carousel_tag != blank %}
        <span class="inside-eyebrow">{{ section.settings.carousel_tag }}</span>
      {% endif %}
      
      {% if section.settings.carousel_headline != blank %}
        <h3 class="inside-headline" style="color: #100F0F !important;">{{ section.settings.carousel_headline }}</h3>
      {% endif %}

      <div class="inside-carousel">
        <button class="carousel-arrow carousel-arrow--prev" aria-label="Previous element">&lsaquo;</button>
        <button class="carousel-arrow carousel-arrow--next" aria-label="Next element">&rsaquo;</button>

        <div class="inside-track" id="insideTrack">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="inside-card" tabindex="0" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  <img class="inside-img"
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.title }}">
                {% else %}
                  {% assign asset_fallback_name = 'moment-of-care.jpg' %}
                  {% case forloop.index %}
                    {% when 1 %}{% assign asset_fallback_name = 'singing bowl with tag3.png' %}
                    {% when 2 %}{% assign asset_fallback_name = 'H1.png' %}
                    {% when 3 %}{% assign asset_fallback_name = 'candle rain 3.png' %}
                    {% when 4 %}{% assign asset_fallback_name = 'H7.png' %}
                    {% when 5 %}{% assign asset_fallback_name = 'tea.png' %}
                  {% endcase %}
                  <img class="inside-img"
                    src="{{ asset_fallback_name | asset_url }}"
                    alt="{{ block.settings.title }}">
                {% endif %}

                <div class="inside-overlay">
                  <span class="inside-title">{{ block.settings.title }}</span>
                  {% if block.settings.subtitle != blank %}
                    <span class="inside-sub">{{ block.settings.subtitle }}</span>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="inside-desc">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="{{ 'Hamper- Inside.png' | asset_url }}" alt="Kauna Grass Basket">
              <div class="inside-overlay">
                <span class="inside-title">Basket</span>
                <span class="inside-sub">Warm &middot; Woven &middot; Rooted</span>
                <p class="inside-desc">Handcrafted from natural kauna grass in Manipur. A beautiful, time-honoured craft bringing warmth and character into any space. A tactile piece with a life beyond the hamper.</p>
              </div>
            </div>
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="{{ 'singing bowl with tag3.png' | asset_url }}" alt="Hand-Hammered Kansa Bowl">
              <div class="inside-overlay">
                <span class="inside-title">Singing Bowl</span>
                <span class="inside-sub">Resonant &middot; Grounding &middot; Timeless</span>
                <p class="inside-desc">Shaped through repeated hammering, its deep resonance creates a moment of pause — a gentle call to stillness, grounding you back to the present.</p>
              </div>
            </div>
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="{{ 'tea.png' | asset_url }}" alt="Flower Tea With Glass Infuser">
              <div class="inside-overlay">
                <span class="inside-title">Flower Tea With Glass Infuser</span>
                <span class="inside-sub">Gentle &middot; Floral &middot; Soothing</span>
                <p class="inside-desc">Carefully picked chamomile, blue corn &amp; rose buds flower tea, paired with a glass infuser for a quiet evening rest ritual.</p>
              </div>
            </div>
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="{{ 'candle rain 3.png' | asset_url }}" alt="Hand-Poured Wax Sachets">
              <div class="inside-overlay">
                <span class="inside-title">Wax Sachets</span>
                <span class="inside-sub">Aromatic &middot; Comforting &middot; Atmospheric</span>
                <p class="inside-desc">Hand-poured fragrant soy wax sachets created to gently change the feeling of spaces and drawers.</p>
              </div>
            </div>
            <div class="inside-card" tabindex="0">
              <img class="inside-img" src="{{ 'H7.png' | asset_url }}" alt="Linen Cotton Napkins">
              <div class="inside-overlay">
                <span class="inside-title">Linen Cotton Napkins</span>
                <span class="inside-sub">Natural &middot; Textured &middot; Everyday</span>
                <p class="inside-desc">A beautiful &amp; tactile cotton-linen weave, chosen to bring warmth and ease to the table.</p>
              </div>
            </div>
          {% endif %}
        </div>

        <!-- Mobile Carousel Dots Indicator -->
        <div class="carousel-dots" id="carouselDots" aria-label="Carousel navigation"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select Featured Product (Direct Checkout)"
    },
    {
      "type": "text",
      "id": "collection_tag",
      "label": "Badge Tag",
      "default": "OUR FIRST COLLECTION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Collection Title",
      "default": "Moment of Care"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Collection Tagline",
      "default": "HAND ASSEMBLED · LIMITED RELEASE"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Italic Quote Line",
      "default": "A gentle reminder that care doesn't always need a reason."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Paragraph",
      "default": "Intentionally curated hamper to bring comfort, calm & a little warmth to the everyday."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "4,850"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Delivery Text",
      "default": "Free Delivery across Delhi NCR"
    },
    {
      "type": "textarea",
      "id": "delivery_note",
      "label": "Delivery Note",
      "default": "Hand-wrapped in signature linen box with custom wax seal & personal note."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Send a Moment of Care"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Main Hamper Image 1"
    },
    {
      "type": "image_picker",
      "id": "featured_image_2",
      "label": "Main Hamper Image 2 (Auto-slides every 2s)"
    },
    {
      "type": "text",
      "id": "carousel_tag",
      "label": "Carousel Badge Tag",
      "default": "Curated Elements"
    },
    {
      "type": "text",
      "id": "carousel_headline",
      "label": "Carousel Headline",
      "default": "Inside the Hamper"
    }
  ],
  "blocks": [
    {
      "type": "inside_item",
      "name": "Inside Element Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Element Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Element Title",
          "default": "Singing Bowl"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sub-tags / Features",
          "default": "Resonant · Grounding · Timeless"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Shaped through repeated hammering, its deep resonance creates a moment of pause."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Product",
      "blocks": [
        {
          "type": "inside_item",
          "settings": {
            "title": "Basket",
            "subtitle": "Warm · Woven · Rooted",
            "description": "Handcrafted from natural kauna grass in Manipur. A beautiful, time-honoured craft bringing warmth and character into any space."
          }
        },
        {
          "type": "inside_item",
          "settings": {
            "title": "Singing Bowl",
            "subtitle": "Resonant · Grounding · Timeless",
            "description": "Shaped through repeated hammering, its deep resonance creates a moment of pause."
          }
        },
        {
          "type": "inside_item",
          "settings": {
            "title": "Flower Tea With Glass Infuser",
            "subtitle": "Gentle · Floral · Soothing",
            "description": "Carefully picked chamomile, blue corn & rose buds flower tea, paired with a glass infuser."
          }
        },
        {
          "type": "inside_item",
          "settings": {
            "title": "Wax Sachets",
            "subtitle": "Aromatic · Comforting · Atmospheric",
            "description": "Hand-poured fragrant soy wax sachets created to gently change the feeling of spaces."
          }
        },
        {
          "type": "inside_item",
          "settings": {
            "title": "Linen Cotton Napkins",
            "subtitle": "Natural · Textured · Everyday",
            "description": "A beautiful & tactile cotton-linen weave, chosen to bring warmth and ease to the table."
          }
        }
      ]
    }
  ]
}
{% endschema %}
