{% comment %}
  Luxury Footer Section
  Fully customizable via Shopify Customizer with repeatable FAQ blocks.
{% endcomment %}

<footer id="contact">
  <div class="wrap">
    <div class="footer-top">
      <!-- Footer Brand Column -->
      <div class="footer-brand">
        <a href="#top" class="footer-logo-link">
          {% if section.settings.footer_logo != blank %}
            <img src="{{ section.settings.footer_logo | image_url: width: 400 }}" alt="{{ section.settings.logo_text | default: 'Amoraki' }}" style="height:32px; width:auto;" class="footer-logo-img">
          {% else %}
            <img src="{{ 'Amoraki- high res white-logo.png' | asset_url }}" alt="Amoraki" style="height:32px; width:auto;" class="footer-logo-img">
          {% endif %}
        </a>
        {% if section.settings.tagline != blank %}
          <span class="script">{{ section.settings.tagline }}</span>
        {% endif %}
        {% if section.settings.delivery_note != blank %}
          <p class="deliver">
            <svg class="pin-icon" viewBox="0 0 20 20" fill="none">
              <path d="M10 18s6-5.7 6-10.4A6 6 0 0 0 4 7.6C4 12.3 10 18 10 18Z" stroke="currentColor" stroke-width="1.2" />
              <circle cx="10" cy="7.6" r="2" stroke="currentColor" stroke-width="1.2" />
            </svg>
            {{ section.settings.delivery_note }}
          </p>
        {% endif %}
      </div>

      <!-- FAQ Accordion Column -->
      <div class="footer-faq">
        <h4>{{ section.settings.faq_heading | default: 'FAQs' }}</h4>
        <button class="faq-teaser" id="faqTeaser">
          Things you may want to know <span class="arrow">&rarr;</span>
        </button>

        <div class="collapse" id="faqList">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="faq-item" {{ block.shopify_attributes }}>
                <button class="faq-q">{{ block.settings.question }}<span class="plus">+</span></button>
                <div class="faq-a">
                  <p>{{ block.settings.answer }}</p>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <!-- Default Fallback FAQ Items -->
            <div class="faq-item">
              <button class="faq-q">What is Amoraki?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>A gifting brand built around moments, not occasions. Moment of Care is our first — for the times care deserves to be felt, not just expressed.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">How do I order?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>Message us on WhatsApp and we'll help you choose and send it — no account, no checkout, just a conversation.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">Do you deliver outside Delhi NCR?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>Not yet. We're starting close to home so every hamper leaves us exactly as intended. More cities are on the way.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">Can I include my own note?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>Always. Every hamper leaves room for your own words — that part is yours to write.</p>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Newsletter Column -->
      <div class="footer-stay">
        <h4>{{ section.settings.newsletter_heading | default: 'Stay Close' }}</h4>
        <p class="stay-copy">{{ section.settings.newsletter_copy | default: 'Stay updated on new collections and reads.' }}</p>
        <form class="stay" id="stayForm">
          <input type="email" id="stayEmail" placeholder="Your email" required>
          <button type="submit" class="stay-btn" aria-label="Subscribe">&rarr;</button>
        </form>
      </div>
    </div>

    <!-- Footer Bottom Row -->
    <div class="footer-bottom">
      <div class="footer-links">
        <a href="{{ section.settings.instagram_link | default: 'https://instagram.com/moments.by.amoraki' }}" target="_blank" rel="noopener">Instagram</a>
        <span class="sep">|</span>
        <a href="{{ section.settings.facebook_link | default: '#' }}" target="_blank" rel="noopener">FB</a>
        <span class="sep">|</span>
        <a href="mailto:{{ section.settings.contact_email | default: 'hello@momentsbyamoraki.com' }}" class="footer-email-link">{{ section.settings.contact_email | default: 'hello@momentsbyamoraki.com' }}</a>
        <span class="sep">|</span>
        <a href="#privacy">Privacy</a>
        <span class="sep">|</span>
        <a href="#terms">Terms</a>
      </div>

      <span class="footer-copy">&copy; 2025 {{ section.settings.copyright_text | default: 'Amoraki. All rights reserved.' }}</span>
    </div>
    
    <svg class="footer-sprig" viewBox="0 0 120 140" fill="none" aria-hidden="true">
      <path d="M10 130C10 90 30 60 55 20" stroke="currentColor" stroke-width="1.1" />
      <path d="M55 20c-8 6-18 8-26 4M55 20c2-10 0-18-6-24M22 60c-8 2-16 0-22-6M30 42c-7 3-15 2-20-3M40 30c-6 4-14 4-19 0" stroke="currentColor" stroke-width="1" />
    </svg>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "amoraki"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "A Moment Wrapped."
    },
    {
      "type": "textarea",
      "id": "delivery_note",
      "label": "Delivery Note",
      "default": "Delivering thoughtfully packaged moments across Delhi NCR and select pan-India locations."
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "FAQ Column Heading",
      "default": "Questions & Care"
    },
    {
      "type": "textarea",
      "id": "faq_teaser_text",
      "label": "FAQ Teaser Text",
      "default": "Have questions about delivery, contents, or custom orders?"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Stay Connected"
    },
    {
      "type": "textarea",
      "id": "newsletter_copy",
      "label": "Newsletter Copy",
      "default": "Receive private previews of upcoming moment curations and seasonal edits."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "hello@amoraki.in"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "WhatsApp URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Amoraki. All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Where do you deliver?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "We provide same-day & scheduled hand-delivery across Delhi NCR."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Where do you deliver?",
            "answer": "We provide same-day & scheduled hand-delivery across Delhi NCR. Pan-India shipping is available for non-perishable hampers via express courier."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I personalize the hamper note?",
            "answer": "Yes. Every hamper includes a handwritten card with your personalized message sealed in custom wax."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the lead time for custom orders?",
            "answer": "Bespoke & corporate orders require 7-14 business days depending on quantity and customization degree."
          }
        }
      ]
    }
  ]
}
{% endschema %}
