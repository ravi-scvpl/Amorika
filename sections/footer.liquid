{% comment %}
  Luxury Footer Section (Exact Match preview.html)
{% endcomment %}

<footer id="contact">
  <div class="wrap">
    <div class="footer-top">
      <!-- Footer Brand Column -->
      <div class="footer-brand">
        <a href="#top" class="nav-logo">amoraki</a>
        <span class="script">A Moment Wrapped.</span>
        <p class="deliver">
          <svg class="pin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 21s-7-4.35-7-10.5a7 7 0 1 1 14 0C19 16.65 12 21 12 21z" />
            <circle cx="12" cy="10.5" r="2.5" />
          </svg>
          Delivering thoughtfully packaged moments across Delhi NCR and select pan-India locations.
        </p>
      </div>

      <!-- FAQ Accordion Column -->
      <div>
        <h4>Questions &amp; Care</h4>
        <button class="faq-teaser" id="faqTeaser">
          Have questions about delivery, contents, or custom orders?
          <br>
          <span class="arrow">View Frequent Enquiries &rarr;</span>
        </button>

        <div class="collapse" id="faqList">
          <div style="margin-top: 18px;">
            <div class="faq-item">
              <button class="faq-q"><span>Where do you deliver?</span><span class="plus">+</span></button>
              <div class="faq-a">
                <p>We provide same-day &amp; scheduled hand-delivery across Delhi NCR. Pan-India shipping is available for non-perishable hampers via express courier.</p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-q"><span>Can I personalize the hamper note?</span><span class="plus">+</span></button>
              <div class="faq-a">
                <p>Yes. Every hamper includes a handwritten card with your personalized message sealed in custom wax.</p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-q"><span>What is the lead time for custom orders?</span><span class="plus">+</span></button>
              <div class="faq-a">
                <p>Bespoke &amp; corporate orders require 7-14 business days depending on quantity and customization degree.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Newsletter Column -->
      <div>
        <h4>Stay Connected</h4>
        <p class="stay-copy">Receive private previews of upcoming moment curations and seasonal edits.</p>
        <form class="stay" id="stayForm">
          <input type="email" id="stayEmail" placeholder="Enter your email" required>
          <button type="submit" class="stay-btn" aria-label="Subscribe">&rarr;</button>
        </form>
      </div>
    </div>

    <!-- Footer Bottom Row -->
    <div class="footer-bottom">
      <div class="footer-social">
        <a href="#" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
          </svg>
        </a>
        <a href="https://wa.me/919999999999" target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
        </a>
      </div>

      <div class="footer-email">
        <a href="mailto:hello@amoraki.in">hello@amoraki.in</a>
      </div>

      <div class="footer-copy">
        &copy; {{ 'now' | date: "%Y" }} Amoraki. All rights reserved.
      </div>
    </div>
  </div>

  <svg class="footer-sprig" viewBox="0 0 100 160" fill="none" stroke="currentColor" stroke-width="1">
    <path d="M50 150Q45 100 50 10M50 120Q30 110 20 90M50 90Q70 80 80 60M50 60Q35 50 25 35M50 35Q65 25 75 10" />
  </svg>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
