{% comment %}
  Luxury Footer Section
  Fully customizable via Shopify Customizer with repeatable FAQ blocks.
{% endcomment %}

<footer id="contact">
  <div class="wrap">
    <div class="footer-top">
      <!-- Column 1: Brand & Logo -->
      <div class="footer-brand">
        <a href="#top" class="footer-logo-link">
          {% if section.settings.footer_logo != blank %}
            <img
              src="{{ section.settings.footer_logo | image_url: width: 400 }}"
              alt="{{ section.settings.logo_text | default: 'Amoraki' }}"
              style="height:32px; width:auto;"
              class="footer-logo-img"
            >
          {% else %}
            <img
              src="{{ 'Amoraki- high res white-logo.png' | asset_url }}"
              alt="Amoraki"
              style="height:32px; width:auto;"
              class="footer-logo-img"
            >
          {% endif %}
        </a>
        {% if section.settings.tagline != blank %}
          <span class="script">{{ section.settings.tagline }}</span>
        {% endif %}
      </div>

      <!-- Column 2: Delivery Coverage -->
      <div class="footer-delivery">
        <h4>Delivery Radius</h4>
        {% if section.settings.delivery_note != blank %}
          <p class="deliver">
            <svg class="pin-icon" viewBox="0 0 20 20" fill="none">
              <path d="M10 18s6-5.7 6-10.4A6 6 0 0 0 4 7.6C4 12.3 10 18 10 18Z" stroke="currentColor" stroke-width="1.2" />
              <circle cx="10" cy="7.6" r="2" stroke="currentColor" stroke-width="1.2" />
            </svg>
            {{ section.settings.delivery_note | default: 'Delhi NCR only' }}
          </p>
        {% endif %}
      </div>

      <!-- FAQ Accordion Column -->
      <div class="footer-faq">
        <h4>{{ section.settings.faq_heading | default: 'FAQs' }}</h4>
        <button class="faq-teaser" id="faqTeaser">
          {{ section.settings.faq_teaser_text | default: 'Things you may want to know' }}
          <span class="arrow">&rarr;</span>
        </button>

        <div class="collapse" id="faqList">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div class="faq-item" {{ block.shopify_attributes }}>
                <button class="faq-q">
                  {{ block.settings.question -}}
                  <span class="plus">+</span>
                </button>
                <div class="faq-a">
                  <p>{{ block.settings.answer }}</p>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <!-- Default Fallback FAQ Items -->
            <div class="faq-item">
              <button class="faq-q">What is amoraki<span class="plus">+</span></button>
              <div class="faq-a">
                <p>amoraki (a-moh-rah-ki) is a home for intentional gifting, where thoughts take shape and feelings lead the way. We curate meaningful gift hampers around moments that matter.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">What is a Moment of Care?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>It’s a thoughtful curated collection to say “I’m thinking of you”</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">Can I buy the individual products separately?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>Our Moment of Care is currently available as a complete collection. Individual pieces may become available in future edits.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">Can I send a Moment of Care directly to someone?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>Yes. You can enter the recipient’s delivery details during checkout, & we’ll ensure the moment is carefully hand-delivered within 2-3 business days.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">Why does delivery take 2–3 days?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>Every hamper is hand-assembled and prepared for its journey after your order is placed. We take a little time to get each one right before it leaves us, so what arrives feels as intentional as what was chosen.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">Can I add a personal message?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>Yes. You can reach out to us on WhatsApp (+91-7827961165) with your order ID and we will be happy to help!</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">Can I order a hamper for myself?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>Of course. Some moments are worth creating for yourself too.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">What payment methods do you accept?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>We accept online payments through our secure payment gateway - Razorpay.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">Can I cancel or modify my order?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>As each Moment of Care is thoughtfully assembled for every order, cancellations or modifications are not possible once an order has been placed.</p>
              </div>
            </div>
            <div class="faq-item">
              <button class="faq-q">Do you offer refunds?<span class="plus">+</span></button>
              <div class="faq-a">
                <p>All purchases are final. We do not offer refunds once an order has been placed. If your Moment of Care arrives damaged, please contact us within 24 hours of delivery with photographs of the package and affected item, and we’ll take it from there.</p>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Newsletter / Contact Column -->
      <div class="footer-stay">
        <h4>Contact</h4>
        <p class="stay-copy">
          Say <a href="mailto:hello@momentsbyamoraki.com" style="color: inherit; text-decoration: underline;">hello@momentsbyamoraki.com</a> and we will reach out to you.
        </p>
      </div>
    </div>

    <!-- Footer Bottom Row -->
    <div class="footer-bottom">
      <div class="footer-links">
        <a
          href="{{ section.settings.instagram_link | default: 'https://instagram.com/moments.by.amoraki' }}"
          target="_blank"
          rel="noopener"
          >Instagram</a
        >
        <span class="sep">|</span>
        <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy</a>
        <span class="sep">|</span>
        <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms</a>
      </div>

      <span class="footer-copy"
        >&copy; 2025 {{ section.settings.copyright_text | default: 'Amoraki. All rights reserved.' -}}
      </span>
    </div>

    <svg class="footer-sprig" viewBox="0 0 120 140" fill="none" aria-hidden="true">
      <path d="M10 130C10 90 30 60 55 20" stroke="currentColor" stroke-width="1.1" />
      <path d="M55 20c-8 6-18 8-26 4M55 20c2-10 0-18-6-24M22 60c-8 2-16 0-22-6M30 42c-7 3-15 2-20-3M40 30c-6 4-14 4-19 0" stroke="currentColor" stroke-width="1" />
    </svg>
  </div>
</footer>

