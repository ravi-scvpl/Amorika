{% comment %}
  Header Section - Moments By Amoraki
  Fully customizable via Shopify Customizer.
{% endcomment %}

<div class="nav-scrim" id="navScrim"></div>

<nav class="nav" id="mainNav">
  <div class="wrap">
    <a href="{{ routes.root_url | default: '#top' }}" class="nav-logo">
      {% if section.settings.logo_image != blank %}
        <img src="{{ section.settings.logo_image | image_url: height: 48 }}" alt="{{ shop.name }}" style="height:28px; width:auto;">
      {% else %}
        <img src="{{ 'black logo.png' | asset_url }}" alt="{{ shop.name | default: 'Amoraki' }}" style="height:28px; width:auto;" class="nav-logo-img">
      {% endif %}
    </a>

    <div class="nav-inline">
      <div class="nav-dropdown" id="navDropdown">
        <button class="nav-dropdown-btn" id="navDropdownBtn" aria-haspopup="true" aria-expanded="false">
          Collections
        </button>
        <div class="nav-dropdown-menu">
          <a href="{{ routes.root_url }}#moment-of-care">Moment of Care</a>
          <a href="{{ routes.root_url }}#on-the-horizon">Moment of Play <span class="soon">Coming Soon</span></a>
          <a href="{{ routes.root_url }}#on-the-horizon">Moment of Synergy <span class="soon">Coming Soon</span></a>
        </div>
      </div>
      <span class="nav-sep">|</span>
      <a href="/blogs/journal">Journal</a>
      <span class="nav-sep">|</span>
      <a href="{{ routes.root_url }}#custom-gifting">Bespoke Gifting</a>
      <span class="nav-sep">|</span>
      <a href="{{ routes.root_url }}#contact">Connect</a>
    </div>

    <div class="nav-actions">
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="nav-header-account" aria-label="Account" style="color: inherit; display: inline-flex; align-items: center; padding: 6px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <a href="{{ routes.cart_url }}" class="nav-header-cart" aria-label="View Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        {% if cart.item_count > 0 %}
          <span class="nav-cart-badge">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      <button class="nav-toggle" id="navToggle" aria-label="Open menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<div class="nav-panel" id="navPanel">
  <button class="nav-panel-close" id="navClose">Close &#10005;</button>
  <div class="nav-links">
    <div class="nav-link-group">
      <span class="nav-link nav-link--head">Collections</span>
      
      <a href="{{ routes.root_url }}#moment-of-care" class="nav-sublink">Moment of Care</a>
      <a href="{{ routes.root_url }}#on-the-horizon" class="nav-sublink">Moment of Play <em>Coming Soon</em></a>
      <a href="{{ routes.root_url }}#on-the-horizon" class="nav-sublink">Moment of Synergy <em>Coming Soon</em></a>
    </div>
    <a href="/blogs/journal" class="nav-link">Journal</a>
    <a href="{{ routes.root_url }}#custom-gifting" class="nav-link">Bespoke Gifting</a>
    <a href="{{ routes.root_url }}#contact" class="nav-link">Connect</a>
    <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="nav-link">
      {% if customer %}My Account{% else %}Sign In / Register{% endif %}
    </a>
    <a href="{{ routes.cart_url }}" class="nav-link nav-link--cart">
      <span>Cart</span>
      {% if cart.item_count > 0 %}
        <span class="nav-panel-cart-badge">{{ cart.item_count }}</span>
      {% else %}
        <span class="nav-panel-cart-badge nav-panel-cart-badge--empty">0</span>
      {% endif %}
    </a>
  </div>
  <div class="nav-panel-foot">
    {{ section.settings.delivery_area | default: 'Delivering across Delhi NCR' }}<br>
    <div style="margin-top: 8px; font-size: 13px; opacity: 0.8;">
      <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" style="text-decoration: underline;">Privacy Policy</a> &bull; 
      <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}" style="text-decoration: underline;">Terms of Service</a>
    </div>
  </div>
</div>

<div id="top"></div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "amoraki"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image (Optional)"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "hello@momentsbyamoraki.com"
    },
    {
      "type": "text",
      "id": "delivery_area",
      "label": "Delivery Area Text",
      "default": "Delivering across Delhi NCR"
    }
  ]
}
{% endschema %}
