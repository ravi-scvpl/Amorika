{% comment %}
  Header Section - Moments By Amoraki
  Fully customizable via Shopify Customizer.
{% endcomment %}

<div class="nav-scrim" id="navScrim"></div>

<nav class="nav" id="mainNav">
  <div class="wrap">
    <a href="{{ routes.root_url | default: '#top' }}" class="nav-logo">
      {% if section.settings.logo_image != blank %}
        <img src="{{ section.settings.logo_image | image_url: height: 48 }}" alt="{{ shop.name }}" style="height:28px; width:auto;">
      {% else %}
        <img src="{{ 'black logo.png' | asset_url }}" alt="{{ shop.name | default: 'Amoraki' }}" style="height:28px; width:auto;" class="nav-logo-img">
      {% endif %}
    </a>

    <div class="nav-inline">
      <div class="nav-dropdown" id="navDropdown">
        <button class="nav-dropdown-btn" id="navDropdownBtn" aria-haspopup="true" aria-expanded="false">
          Collections
        </button>
        <div class="nav-dropdown-menu">
          <a href="#moment-of-care">Moment of Care</a>
          <a href="#on-the-horizon">Moment of Play <span class="soon">Coming Soon</span></a>
          <a href="#on-the-horizon">Moment of Synergy <span class="soon">Coming Soon</span></a>
        </div>
      </div>
      <a href="#journal">Journal</a>
      <a href="#custom-gifting">Bespoke Gifting</a>
      <a href="#contact">Connect</a>
    </div>

    <button class="nav-toggle" id="navToggle" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>
</nav>

<div class="nav-panel" id="navPanel">
  <button class="nav-panel-close" id="navClose">Close &#10005;</button>
  <div class="nav-links">
    <div class="nav-link-group">
      <span class="nav-link nav-link--head">Collections</span>
      <a href="#moment-of-care" class="nav-sublink">Moment of Care</a>
      <a href="#on-the-horizon" class="nav-sublink">Moment of Play <em>Coming Soon</em></a>
      <a href="#on-the-horizon" class="nav-sublink">Moment of Synergy <em>Coming Soon</em></a>
    </div>
    <a href="#journal" class="nav-link">Journal</a>
    <a href="#custom-gifting" class="nav-link">Bespoke Gifting</a>
    <a href="#contact" class="nav-link">Connect</a>
  </div>
  <div class="nav-panel-foot">
    {{ section.settings.contact_email | default: 'hello@amoraki.in' }}<br>
    {{ section.settings.delivery_area | default: 'Delivering across Delhi NCR' }}<br>
    <div style="margin-top: 8px; font-size: 13px; opacity: 0.8;">
      <a href="{{ routes.root_url }}pages/privacy" style="text-decoration: underline;">Privacy Policy</a> &bull; 
      <a href="{{ routes.root_url }}pages/terms" style="text-decoration: underline;">Terms of Service</a>
    </div>
  </div>
</div>

<div id="top"></div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "amoraki"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image (Optional)"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "hello@amoraki.in"
    },
    {
      "type": "text",
      "id": "delivery_area",
      "label": "Delivery Area Text",
      "default": "Delivering across Delhi NCR"
    }
  ]
}
{% endschema %}
