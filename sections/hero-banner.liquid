{% comment %}
  Hero Banner Section - Moments By Amoraki
  Fully configurable via Shopify Customizer with image_picker and text options.
{% endcomment %}

<section class="hero">
  {% if section.settings.hero_image != blank %}
    <img class="hero-img"
      src="{{ section.settings.hero_image | image_url: width: 2000 }}"
      alt="{{ section.settings.hero_image.alt | default: section.settings.brand_name }}">
  {% else %}
    <img class="hero-img"
      src="{{ 'hero-hamper.jpg' | asset_url }}"
      alt="{{ section.settings.brand_name }}">
  {% endif %}
  
  <div class="hero-scrim"></div>

  <div class="hero-content">
    <div class="wrap">
      <h1>
        <span class="hero-brand-word">{{ section.settings.brand_name | default: 'amoraki' }}</span>
        {% if section.settings.tagline != blank %}
          <span class="script">{{ section.settings.tagline }}</span>
        {% endif %}
      </h1>

      {% if section.settings.subtitle_left != blank or section.settings.subtitle_right != blank %}
        <div class="hero-eyebrow">
          <span class="hero-subtitle">
            {% if section.settings.subtitle_left != blank %}
              <span>{{ section.settings.subtitle_left }}</span>
            {% endif %}
            {% if section.settings.subtitle_left != blank and section.settings.subtitle_right != blank %}
              <span class="sub-dot">&bull;</span>
            {% endif %}
            {% if section.settings.subtitle_right != blank %}
              <span>{{ section.settings.subtitle_right }}</span>
            {% endif %}
          </span>
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="hero-sub">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="{{ section.settings.cta_link | default: '#moment-of-care' }}" class="btn btn--primary">
            {{ section.settings.cta_label }} &rarr;
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name / Travelling Logo Text",
      "default": "amoraki"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Script Tagline",
      "default": "A Moment Wrapped."
    },
    {
      "type": "text",
      "id": "subtitle_left",
      "label": "Subtitle Left",
      "default": "HOME OF INTENTIONAL GIFTING"
    },
    {
      "type": "text",
      "id": "subtitle_right",
      "label": "Subtitle Right",
      "default": "SUSTAINABLY CURATED"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Paragraph",
      "default": "Designed to be felt long after it's unwrapped."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
