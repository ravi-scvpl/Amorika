{% comment %}
  Hero Banner Section - Moments By Amoraki (Exact Match preview.html)
{% endcomment %}

<section class="hero">
  <img class="hero-img"
    src="https://images.unsplash.com/photo-1602928321679-560b4139c907?q=80&w=2000&auto=format&fit=crop"
    alt="{{ section.settings.image_alt | default: 'Brass singing bowl and mallet on slate' }}">
  
  <div class="hero-scrim"></div>

  <div class="hero-content">
    <div class="wrap">
      <h1>
        <span class="hero-brand-word">{{ section.settings.brand_name | default: 'amoraki' }}</span>
        <span class="script">{{ section.settings.tagline | default: 'A Moment Wrapped.' }}</span>
      </h1>

      <div class="hero-eyebrow">
        <span class="hero-subtitle">
          <span>{{ section.settings.subtitle_left | default: 'HOME OF INTENTIONAL GIFTING' }}</span>
          <span class="sub-dot">&bull;</span>
          <span>{{ section.settings.subtitle_right | default: 'SUSTAINABLY CURATED' }}</span>
        </span>
      </div>

      <p class="hero-sub">{{ section.settings.description | default: "Designed to be felt long after it's unwrapped." }}</p>

      <div style="display: flex; gap: 16px; flex-wrap: wrap;">
        <a href="{{ section.settings.cta_link | default: '#moment-of-care' }}" class="btn btn--primary">
          {{ section.settings.cta_label | default: 'Explore Collection' }} &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "amoraki"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "A Moment Wrapped."
    },
    {
      "type": "text",
      "id": "subtitle_left",
      "label": "Subtitle Left",
      "default": "HOME OF INTENTIONAL GIFTING"
    },
    {
      "type": "text",
      "id": "subtitle_right",
      "label": "Subtitle Right",
      "default": "SUSTAINABLY CURATED"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Designed to be felt long after it's unwrapped."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
