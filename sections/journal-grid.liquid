{% comment %}
  Journal Grid Section
  Supports dynamic blog article fetching from Shopify Admin as well as manual customizable article blocks.
{% endcomment %}

{% assign selected_blog = section.settings.blog %}

<section class="sec-edit reveal" id="journal">
  <div class="wrap">
    <div class="edit-grid">
      <div class="edit-left">
        {% if section.settings.section_tag != blank %}
          <span class="tag tag--kauna">{{ section.settings.section_tag }}</span>
        {% endif %}
        <h2>{{ section.settings.title | default: 'Journal' }}</h2>
        {% if section.settings.subtitle != blank %}
          <p>{{ section.settings.subtitle }}</p>
        {% endif %}
        {% if section.settings.button_text != blank %}
          {% assign button_href = section.settings.button_url %}
          {% if button_href == blank and selected_blog != blank %}
            {% assign button_href = selected_blog.url %}
          {% endif %}
          {% if button_href == blank %}
            {% assign button_href = '/blogs/news' %}
          {% endif %}
          <a href="{{ button_href }}" class="edit-link">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>

      <div class="edit-images">
        {% if selected_blog != blank and selected_blog.articles.size > 0 %}
          {% for article in selected_blog.articles limit: 3 %}
            <a href="{{ article.url }}" class="edit-item">
              {% if article.metafields.custom.homepage_thumbnail != blank %}
                <img class="edit-img"
                  src="{{ article.metafields.custom.homepage_thumbnail | image_url: width: 800 }}"
                  alt="{{ article.title }}">
              {% elsif article.image %}
                <img class="edit-img"
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.image.alt | default: article.title }}">
              {% else %}
                {% assign journal_fallback = 'journal-1.jpg' %}
                {% case forloop.index %}
                  {% when 2 %}{% assign journal_fallback = 'journal-2.jpg' %}
                  {% when 3 %}{% assign journal_fallback = 'journal-3.jpg' %}
                {% endcase %}
                <img class="edit-img"
                  src="{{ journal_fallback | asset_url }}"
                  alt="{{ article.title }}">
              {% endif %}
              <span class="edit-caption">{{ article.title }}</span>
            </a>
          {% endfor %}
        {% elsif section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign fallback_link = '/blogs/news/why-presence-outlasts-presents' %}
            {% case forloop.index %}
              {% when 2 %}{% assign fallback_link = '/blogs/news/the-art-of-slow-gifting' %}
              {% when 3 %}{% assign fallback_link = '/blogs/news/beyond-the-occasion' %}
            {% endcase %}
            <a href="{{ block.settings.link | default: fallback_link }}" class="edit-item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img class="edit-img"
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.caption }}">
              {% else %}
                {% assign journal_fallback = 'journal-1.jpg' %}
                {% case forloop.index %}
                  {% when 2 %}{% assign journal_fallback = 'journal-2.jpg' %}
                  {% when 3 %}{% assign journal_fallback = 'journal-3.jpg' %}
                {% endcase %}
                <img class="edit-img"
                  src="{{ journal_fallback | asset_url }}"
                  alt="{{ block.settings.caption }}">
              {% endif %}
              <span class="edit-caption">{{ block.settings.caption }}</span>
            </a>
          {% endfor %}
        {% else %}
          <!-- Default Fallback Articles -->
          <a href="/blogs/news/why-presence-outlasts-presents" class="edit-item">
            <img class="edit-img" src="{{ 'journal-1.jpg' | asset_url }}" alt="Why Presence Outlasts Presents">
            <span class="edit-caption">Why Presence Outlasts Presents</span>
          </a>
          <a href="/blogs/news/the-art-of-slow-gifting" class="edit-item">
            <img class="edit-img" src="{{ 'journal-2.jpg' | asset_url }}" alt="The Art of Slow Gifting">
            <span class="edit-caption">The Art of Slow Gifting</span>
          </a>
          <a href="/blogs/news/beyond-the-occasion" class="edit-item">
            <img class="edit-img" src="{{ 'journal-3.jpg' | asset_url }}" alt="Beyond the Occasion">
            <span class="edit-caption">Beyond the Occasion</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_tag",
      "label": "Section Badge Tag"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Journal"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Thoughts on intentional gifting, sensory experiences and everyday rituals."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog (Dynamic Fetch)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Slow Reads →"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "article_card",
      "name": "Journal Article Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Article Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Article Title / Caption",
          "default": "Why Presence Outlasts Presents"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journal Grid",
      "blocks": [
        {
          "type": "article_card",
          "settings": {
            "caption": "Why Presence Outlasts Presents",
            "link": "/blogs/news/why-presence-outlasts-presents"
          }
        },
        {
          "type": "article_card",
          "settings": {
            "caption": "The Art of Slow Gifting",
            "link": "/blogs/news/the-art-of-slow-gifting"
          }
        },
        {
          "type": "article_card",
          "settings": {
            "caption": "Beyond the Occasion",
            "link": "/blogs/news/beyond-the-occasion"
          }
        }
      ]
    }
  ]
}
{% endschema %}
