{% comment %}
  The Edit / Journal Grid Section (Exact Match preview.html)
{% endcomment %}

<section class="sec-edit reveal" id="journal">
  <div class="wrap">
    <div class="edit-grid">
      <div class="edit-left">
        <span class="tag tag--kauna">Editorial</span>
        <h2>{{ section.settings.title | default: 'The Edit' }}</h2>
        <p>{{ section.settings.subtitle | default: 'Thoughts on slow gifting, seasonal rituals, and the art of intention.' }}</p>
      </div>

      <div class="edit-images">
        <!-- Article 1 -->
        <a href="#" class="edit-item">
          <img class="edit-img"
            src="https://images.unsplash.com/photo-1544816155-12df9643f363?q=80&w=800&auto=format&fit=crop"
            alt="Brass Kansa cup with tea">
          <span class="edit-caption">Why We Choose Kansa Over Ceramic</span>
        </a>

        <!-- Article 2 -->
        <a href="#" class="edit-item">
          <img class="edit-img"
            src="https://images.unsplash.com/photo-1603006905003-be475563bc59?q=80&w=800&auto=format&fit=crop"
            alt="Hand-poured soy candle and brass holder">
          <span class="edit-caption">The Evening Pause: Building a Rest Ritual</span>
        </a>

        <!-- Article 3 -->
        <a href="#" class="edit-item">
          <img class="edit-img"
            src="https://images.unsplash.com/photo-1506126613408-eca07ce68773?q=80&w=800&auto=format&fit=crop"
            alt="Artisan brass incense holder with smoke">
          <span class="edit-caption">Artisans of Delhi NCR: Small-Batch Stories</span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Edit"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Thoughts on slow gifting, seasonal rituals, and the art of intention."
    }
  ],
  "presets": [
    {
      "name": "Journal Grid"
    }
  ]
}
{% endschema %}
