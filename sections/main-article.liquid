{% comment %}
  Main Article Section - Moments By Amoraki
{% endcomment %}

<article class="main-article-section" style="padding: clamp(3rem, 6vw, 5rem) 0;">
  <div class="container" style="max-width: 800px;">
    <div style="text-align: center; margin-bottom: 2.5rem;">
      <span class="eyebrow">JOURNAL</span>
      <h1 class="h2" style="margin-bottom: 1rem;">{{ article.title }}</h1>
      <p style="font-size: 0.8125rem; color: var(--color-text-subtle);">{{ article.published_at | date: '%B %d, %Y' }}</p>
    </div>

    {%- if article.image -%}
      <div style="margin-bottom: 2.5rem; border-radius: var(--radius-sm); overflow: hidden;">
        <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title | escape }}" loading="eager" />
      </div>
    {%- endif -%}

    <div class="article-content" style="line-height: 1.9; color: var(--color-text-muted); font-size: 1rem;">
      {{ article.content }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Main Article",
  "settings": []
}
{% endschema %}
