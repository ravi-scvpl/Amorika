{% comment %}
  Main Cart Section - Moments By Amoraki
  Full Page Dedicated Luxury Cart Template (/cart)
{% endcomment %}

<div class="cart-page-hero" style="background: var(--linen-soft); padding: clamp(4rem, 7vw, 5.5rem) 0 3rem; border-bottom: 1px solid var(--line);">
  <div class="wrap" style="text-align: center; max-width: 760px;">
    <h1 class="h2" style="font-family: var(--font-display); font-size: clamp(32px, 5vw, 48px); font-weight: 500; margin-bottom: 8px; color: var(--ink);">
      Your Moment Hamper
    </h1>
    <p style="font-size: 15px; color: var(--taupe); max-width: 520px; margin: 0 auto; line-height: 1.5;">
      A few more details and we'll begin wrapping your chosen moment
    </p>
  </div>
</div>

<section class="main-cart-section" style="padding: clamp(3rem, 6vw, 5rem) 0;">
  <style>
    /* Desktop cart grid layout */
    .cart-page-header,
    .cart-page-item {
      display: grid !important;
      grid-template-columns: 100px 1fr 110px 110px !important;
      gap: 16px !important;
      align-items: center !important;
    }
    
    .cart-page-item {
      padding-bottom: 24px !important;
      border-bottom: 1px solid var(--line) !important;
    }

    .cart-page-qty {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
      border: 1px solid var(--line) !important;
      border-radius: 4px !important;
      width: 90px !important;
      height: 38px !important;
      margin: 0 auto !important;
      background: var(--white) !important;
      padding: 0 4px !important;
      box-sizing: border-box !important;
    }

    .cart-page-qty a {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 28px !important;
      height: 100% !important;
      font-size: 16px !important;
      color: var(--ink) !important;
      text-decoration: none !important;
      font-weight: 500 !important;
    }

    .cart-page-qty span {
      font-size: 14px !important;
      font-weight: 600 !important;
      text-align: center !important;
      flex: 1 !important;
      color: var(--ink) !important;
    }

    /* Mobile responsive layout */
    @media (max-width: 767px) {
      .cart-page-grid {
        grid-template-columns: 1fr !important;
        gap: 32px !important;
      }
      .cart-page-header {
        display: none !important;
      }
      .cart-page-item {
        display: grid !important;
        grid-template-columns: 75px 1fr !important;
        gap: 12px 16px !important;
        align-items: center !important;
        padding-bottom: 20px !important;
      }
      .cart-item-thumb {
        grid-column: 1 !important;
        grid-row: 1 !important;
        width: 75px !important;
        height: 75px !important;
      }
      .cart-page-item-info {
        grid-column: 2 !important;
        grid-row: 1 !important;
      }
      .cart-page-qty {
        grid-column: 1 !important;
        grid-row: 2 !important;
        margin: 0 !important;
        width: 90px !important;
        height: 36px !important;
      }
      .cart-page-amount {
        grid-column: 2 !important;
        grid-row: 2 !important;
        text-align: right !important;
        font-size: 16px !important;
        font-weight: 600 !important;
        color: var(--ink) !important;
      }
    }
  </style>

  <div class="wrap" style="max-width: 1040px;">
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="cart-page-grid" style="display: grid; grid-template-columns: 1fr 360px; gap: 48px; align-items: start;">
        
        <!-- Cart Items Column -->
        <div class="cart-page-items" style="display: flex; flex-direction: column; gap: 24px;">
          <div class="cart-page-header" style="padding-bottom: 16px; border-bottom: 1px solid var(--line); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--taupe); font-weight: 600;">
            <span>Collection</span>
            <span style="padding-left: 20px;">Details</span>
            <span style="text-align: center;">Quantity</span>
            <span style="text-align: right;">Amount</span>
          </div>

          {% for item in cart.items %}
            <div class="cart-page-item">
              <a href="{{ item.url }}" class="cart-item-thumb" style="display: block; width: 90px; height: 90px; overflow: hidden; border-radius: 4px; background: #EFE8DC;">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                  <img src="{{ 'moment-of-care.jpg' | asset_url }}" alt="Amoraki Hamper" style="width: 100%; height: 100%; object-fit: cover;">
                {% endif %}
              </a>

              <div class="cart-page-item-info">
                <a href="{{ item.url }}" style="font-family: var(--font-display); font-size: 19px; font-weight: 500; color: var(--ink); text-decoration: none; display: block; margin-bottom: 4px;">
                  {{ item.product.title }}
                </a>
                {% if item.variant.title != 'Default Title' and item.variant.title != blank %}
                  <span style="font-size: 13px; color: var(--taupe); display: block; margin-bottom: 4px;">{{ item.variant.title }}</span>
                {% endif %}
              </div>

              <!-- Quantity Selector -->
              <div class="cart-page-qty">
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}">-</a>
                <span>{{ item.quantity }}</span>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}">+</a>
              </div>

              <!-- Item Line Amount -->
              <div class="cart-page-amount" style="text-align: right; font-family: var(--font-sans); font-size: 16px; font-weight: 600; color: var(--ink);">
                {{ item.final_line_price | money }}
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Summary & Order Notes Column -->
        <div class="cart-page-summary" style="background: var(--linen-soft); border: 1px solid var(--line); border-radius: 8px; padding: 28px 24px; position: sticky; top: 100px;">
          <h3 style="font-family: var(--font-display); font-size: 22px; font-weight: 500; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--line); color: var(--ink);">
            Order Summary
          </h3>

          <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 15px; color: var(--ink);">
            <span>Item Total</span>
            <span style="font-weight: 600;">{{ cart.total_price | money }}</span>
          </div>

          <div style="display: flex; justify-content: space-between; margin-bottom: 14px; font-size: 14px; color: var(--taupe);">
            <span>Hand delivery fee</span>
            <span>+ ₹200</span>
          </div>

          <div style="display: flex; justify-content: space-between; padding-top: 14px; border-top: 1px dashed var(--line); margin-bottom: 20px; font-size: 16px; font-weight: 600; color: var(--ink);">
            <span>Total Amount</span>
            <div style="text-align: right;">
              <div style="color: var(--copper-deep); font-size: 18px;">{{ cart.total_price | plus: 20000 | money }}</div>
              <span style="font-size: 11px; font-weight: 400; color: var(--taupe); display: block;">inclusive of all taxes</span>
            </div>
          </div>

          {% render 'cart-recipient-fields' %}

          <button type="submit" name="checkout" class="btn btn--primary" style="width: 100%; padding: 14px 20px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--copper-deep); color: var(--white); border: none; border-radius: 4px; cursor: pointer; transition: background 0.3s ease; margin-bottom: 14px;">
            Continue to pay &rarr;
          </button>

          <p style="font-size: 12.5px; color: var(--ink); text-align: center; margin-bottom: 14px; line-height: 1.5;">
            In case of any query reach us on our <a href="https://wa.me/917827961165" target="_blank" rel="noopener" style="color: var(--copper-deep); text-decoration: underline; font-weight: 500;">WhatsApp</a>.
          </p>

          <a href="{{ routes.root_url }}#moment-of-care" style="display: block; text-align: center; margin-top: 12px; font-size: 13px; color: var(--taupe); text-decoration: underline;">
            Continue Exploring Curations
          </a>
        </div>
      </form>

    {% else %}
      <!-- Empty Bag State -->
      <div class="cart-empty-state" style="text-align: center; max-width: 520px; margin: 0 auto; padding: 4rem 1rem;">
        <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--linen-soft); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        </div>
        <h2 style="font-family: var(--font-display); font-size: 32px; font-weight: 500; margin-bottom: 12px; color: var(--ink);">Your bag is currently empty</h2>
        <p style="font-size: 15px; color: var(--taupe); margin-bottom: 28px; line-height: 1.6;">
          Care doesn't always need a reason. Explore our curations to send a quiet moment to someone worth thinking of.
        </p>
        <a href="{{ routes.root_url }}#moment-of-care" class="btn btn--primary" style="display: inline-block; padding: 14px 28px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--copper-deep); color: var(--white); border-radius: 4px; text-decoration: none;">
          Explore Moment of Care &rarr;
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
