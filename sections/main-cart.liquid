{% comment %}
  Main Cart Section - Moments By Amoraki
  Full Page Dedicated Luxury Cart Template (/cart)
{% endcomment %}

<div class="cart-page-hero" style="background: var(--linen-soft); padding: clamp(4rem, 7vw, 5.5rem) 0 3rem; border-bottom: 1px solid var(--line);">
  <div class="wrap" style="text-align: center; max-width: 760px;">
    <span class="sec-num" style="display: inline-block; margin-bottom: 12px;">MOMENTS BY AMORAKI</span>
    <h1 class="h2" style="font-family: var(--font-display); font-size: clamp(32px, 5vw, 48px); font-weight: 500; margin-bottom: 12px; color: var(--ink);">
      Your Curated Bag
    </h1>
    <p style="font-size: 15px; color: var(--taupe); max-width: 460px; margin: 0 auto;">
      A collection of sensory items chosen with care and intention.
    </p>
  </div>
</div>

<section class="main-cart-section" style="padding: clamp(3rem, 6vw, 5rem) 0;">
  <div class="wrap" style="max-width: 1040px;">
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="cart-page-grid" style="display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: start;">
        
        <!-- Cart Items Column -->
        <div class="cart-page-items" style="display: flex; flex-direction: column; gap: 24px;">
          <div class="cart-page-header" style="display: grid; grid-template-columns: 100px 1fr 120px 100px; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--taupe); font-weight: 600;">
            <span>Item</span>
            <span>Details</span>
            <span style="text-align: center;">Quantity</span>
            <span style="text-align: right;">Total</span>
          </div>

          {% for item in cart.items %}
            <div class="cart-page-item" style="display: grid; grid-template-columns: 100px 1fr 120px 100px; gap: 16px; align-items: center; padding-bottom: 24px; border-bottom: 1px solid var(--line);">
              <a href="{{ item.url }}" style="display: block; width: 100px; height: 100px; overflow: hidden; border-radius: 4px; background: #EFE8DC;">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                  <img src="{{ 'moment-of-care.jpg' | asset_url }}" alt="Amoraki Hamper" style="width: 100%; height: 100%; object-fit: cover;">
                {% endif %}
              </a>

              <div class="cart-page-item-info">
                <a href="{{ item.url }}" style="font-family: var(--font-display); font-size: 20px; font-weight: 500; color: var(--ink); text-decoration: none; display: block; margin-bottom: 4px;">
                  {{ item.product.title }}
                </a>
                {% if item.variant.title != 'Default Title' and item.variant.title != blank %}
                  <span style="font-size: 13px; color: var(--taupe); display: block; margin-bottom: 4px;">{{ item.variant.title }}</span>
                {% endif %}
                <span style="font-size: 14px; color: var(--copper-deep); font-weight: 500;">{{ item.final_price | money }}</span>
                <div style="margin-top: 8px;">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" style="font-size: 12px; color: #a3423c; text-decoration: underline;">Remove</a>
                </div>
              </div>

              <!-- Quantity Selector -->
              <div class="cart-page-qty" style="display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 4px; width: 100px; height: 40px; margin: 0 auto; background: var(--white);">
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" style="padding: 0 12px; font-size: 16px; color: var(--ink); text-decoration: none;">-</a>
                <span style="font-size: 14px; font-weight: 500; width: 30px; text-align: center;">{{ item.quantity }}</span>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" style="padding: 0 12px; font-size: 16px; color: var(--ink); text-decoration: none;">+</a>
              </div>

              <!-- Item Total -->
              <div style="text-align: right; font-family: var(--font-sans); font-size: 16px; font-weight: 600; color: var(--ink);">
                {{ item.final_line_price | money }}
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Summary & Order Notes Column -->
        <div class="cart-page-summary" style="background: var(--linen-soft); border: 1px solid var(--line); border-radius: 8px; padding: 28px 24px; position: sticky; top: 100px;">
          <h3 style="font-family: var(--font-display); font-size: 22px; font-weight: 500; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--line); color: var(--ink);">
            Order Summary
          </h3>

          <div style="display: flex; justify-content: space-between; margin-bottom: 14px; font-size: 15px; color: var(--ink);">
            <span>Subtotal</span>
            <span style="font-weight: 600; color: var(--copper-deep);">{{ cart.total_price | money }}</span>
          </div>

          <div style="font-size: 13px; color: var(--taupe); line-height: 1.6; margin-bottom: 24px; padding: 12px; background: rgba(138, 67, 36, 0.05); border-radius: 4px; border-left: 2px solid var(--copper);">
            <strong>Delivery Note:</strong> Hand-delivered across Delhi NCR (+ ₹200 delivery). Taxes calculated at checkout.
          </div>

          <div style="margin-bottom: 24px;">
            <label for="CartSpecialInstructions" style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; color: var(--ink);">
              Handwritten Card Note / Special Requests:
            </label>
            <textarea name="note" id="CartSpecialInstructions" rows="3" placeholder="Write your personal note to be hand-sealed inside the hamper..." style="width: 100%; border: 1px solid var(--line); border-radius: 4px; padding: 10px; font-family: var(--font-sans); font-size: 13px; background: var(--white); color: var(--ink); resize: vertical;">{{ cart.note }}</textarea>
          </div>

          <button type="submit" name="checkout" class="btn btn--primary" style="width: 100%; padding: 14px 20px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--copper-deep); color: var(--white); border: none; border-radius: 4px; cursor: pointer; transition: background 0.3s ease;">
            Proceed to Checkout &rarr;
          </button>

          <a href="{{ routes.root_url }}#moment-of-care" style="display: block; text-align: center; margin-top: 16px; font-size: 13px; color: var(--taupe); text-decoration: underline;">
            Continue Exploring Curations
          </a>
        </div>
      </form>

    {% else %}
      <!-- Empty Bag State -->
      <div class="cart-empty-state" style="text-align: center; max-width: 520px; margin: 0 auto; padding: 4rem 1rem;">
        <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--linen-soft); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        </div>
        <h2 style="font-family: var(--font-display); font-size: 32px; font-weight: 500; margin-bottom: 12px; color: var(--ink);">Your bag is currently empty</h2>
        <p style="font-size: 15px; color: var(--taupe); margin-bottom: 28px; line-height: 1.6;">
          Care doesn't always need a reason. Explore our curations to send a quiet moment to someone worth thinking of.
        </p>
        <a href="{{ routes.root_url }}#moment-of-care" class="btn btn--primary" style="display: inline-block; padding: 14px 28px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--copper-deep); color: var(--white); border-radius: 4px; text-decoration: none;">
          Explore Moment of Care &rarr;
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
