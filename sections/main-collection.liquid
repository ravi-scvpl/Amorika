{% comment %}
  Main Collection Section - Moments By Amoraki
  Full Page Dedicated Collection View
{% endcomment %}

<div class="collection-page-hero" style="background: var(--linen-soft); padding: clamp(4rem, 7vw, 5.5rem) 0 3rem; border-bottom: 1px solid var(--line);">
  <div class="wrap" style="text-align: center; max-width: 760px;">
    <span class="sec-num" style="display: inline-block; margin-bottom: 12px;">CURATED COLLECTIONS</span>
    <h1 class="h2" style="font-family: var(--font-display); font-size: clamp(32px, 5vw, 48px); font-weight: 500; margin-bottom: 12px; color: var(--ink);">
      {{ collection.title | default: 'The World of Moments' }}
    </h1>
    <p style="font-size: 15px; color: var(--taupe); max-width: 520px; margin: 0 auto; line-height: 1.65;">
      {{ collection.description | default: "Hand-assembled curations designed to bring stillness, warmth, and sensory connection long after they're unwrapped." }}
    </p>
  </div>
</div>

<section class="main-collection-section" style="padding: clamp(3rem, 6vw, 5rem) 0;">
  <div class="wrap" style="max-width: 1140px;">
    <div class="collection-products-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 32px;">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <div class="collection-demo-card" style="background: var(--white); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease;">
          <div style="aspect-ratio: 4/3; overflow: hidden; background: #EFE8DC;">
            <img src="{{ 'moment-of-care.jpg' | asset_url }}" alt="Moment of Care" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div style="padding: 24px; text-align: center;">
            <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--copper-deep); display: block; margin-bottom: 6px;">FIRST RELEASE</span>
            <h3 style="font-family: var(--font-display); font-size: 22px; font-weight: 500; color: var(--ink); margin-bottom: 8px;">Moment of Care</h3>
            <p style="font-size: 13px; color: var(--taupe); margin-bottom: 16px; line-height: 1.5;">Kauna Grass Basket, Hammered Singing Bowl, Organic Flower Tea & Soy Wax Sachets.</p>
            <div style="font-family: var(--font-sans); font-size: 18px; font-weight: 600; color: var(--copper-deep); margin-bottom: 20px;">₹5,490</div>
            <a href="{{ routes.root_url }}#moment-of-care" class="btn btn--primary" style="display: block; width: 100%; padding: 12px 20px; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--copper-deep); color: var(--white); border-radius: 4px; text-decoration: none;">
              Explore Collection &rarr;
            </a>
          </div>
        </div>

        <div class="collection-demo-card" style="background: var(--white); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; opacity: 0.85;">
          <div style="aspect-ratio: 4/3; overflow: hidden; background: #EFE8DC; position: relative;">
            <img src="{{ 'hero-hamper.jpg' | asset_url }}" alt="Moment of Play" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(20%);">
            <span style="position: absolute; top: 12px; right: 12px; background: rgba(16, 15, 15, 0.75); color: #E2C785; font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px;">COMING SOON</span>
          </div>
          <div style="padding: 24px; text-align: center;">
            <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--taupe); display: block; margin-bottom: 6px;">ON THE HORIZON</span>
            <h3 style="font-family: var(--font-display); font-size: 22px; font-weight: 500; color: var(--ink); margin-bottom: 8px;">Moment of Play</h3>
            <p style="font-size: 13px; color: var(--taupe); margin-bottom: 16px; line-height: 1.5;">Curated for lighthearted joy, conversation, and shared gathering.</p>
            <a href="https://wa.me/919999999999?text=Hi%2C%20please%20notify%20me%20when%20Moment%20of%20Play%20launches." target="_blank" rel="noopener" class="notify-link" style="display: block; width: 100%; padding: 12px 20px; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; border: 1px solid var(--line); color: var(--ink); border-radius: 4px; text-decoration: none;">
              Notify Me &rarr;
            </a>
          </div>
        </div>

        <div class="collection-demo-card" style="background: var(--white); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; opacity: 0.85;">
          <div style="aspect-ratio: 4/3; overflow: hidden; background: #EFE8DC; position: relative;">
            <img src="{{ 'custom-gifting.jpg' | asset_url }}" alt="Moment of Synergy" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(20%);">
            <span style="position: absolute; top: 12px; right: 12px; background: rgba(16, 15, 15, 0.75); color: #E2C785; font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px;">COMING SOON</span>
          </div>
          <div style="padding: 24px; text-align: center;">
            <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--taupe); display: block; margin-bottom: 6px;">ON THE HORIZON</span>
            <h3 style="font-family: var(--font-display); font-size: 22px; font-weight: 500; color: var(--ink); margin-bottom: 8px;">Moment of Synergy</h3>
            <p style="font-size: 13px; color: var(--taupe); margin-bottom: 16px; line-height: 1.5;">Crafted for corporate intent, partnerships, and collective milestones.</p>
            <a href="https://wa.me/919999999999?text=Hi%2C%20please%20notify%20me%20when%20Moment%20of%20Synergy%20launches." target="_blank" rel="noopener" class="notify-link" style="display: block; width: 100%; padding: 12px 20px; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; border: 1px solid var(--line); color: var(--ink); border-radius: 4px; text-decoration: none;">
              Notify Me &rarr;
            </a>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
