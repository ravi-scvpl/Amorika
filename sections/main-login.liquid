{% comment %}
  Main Login & Registration Section - Moments By Amoraki
  Luxury minimal customer authentication template (/account/login)
{% endcomment %}

<div class="login-page-hero" style="background: var(--linen-soft, #F7F3ED); padding: clamp(3.5rem, 6vw, 5rem) 0 2.5rem; border-bottom: 1px solid var(--line, #E5DEC9); text-align: center;">
  <div class="wrap" style="max-width: 600px;">
    <h1 class="h2" style="font-family: var(--font-display, 'Cormorant Garamond', serif); font-size: clamp(30px, 4.5vw, 44px); font-weight: 500; margin-bottom: 8px; color: var(--ink, #2C2623);">
      Welcome to Amoraki
    </h1>
    <p style="font-size: 14.5px; color: var(--taupe, #706862); max-width: 440px; margin: 0 auto; line-height: 1.5;">
      Sign in to view your orders, delivery details, and saved moments of care.
    </p>
  </div>
</div>

<section class="login-section" style="padding: clamp(3rem, 5vw, 4.5rem) 0; background: var(--white, #FFF);">
  <div class="wrap" style="max-width: 460px; margin: 0 auto;">

    <!-- Recover Password Form (Hidden by default) -->
    <div id="RecoverPasswordForm" style="display: none; background: var(--linen-soft, #F7F3ED); border: 1px solid var(--line, #E5DEC9); border-radius: 8px; padding: 28px 24px; margin-bottom: 30px;">
      <h2 style="font-family: var(--font-display, serif); font-size: 24px; font-weight: 500; color: var(--ink, #2C2623); margin-bottom: 8px; text-align: center;">
        Reset your password
      </h2>
      <p style="font-size: 13.5px; color: var(--taupe, #706862); text-align: center; margin-bottom: 20px; line-height: 1.5;">
        We will send you an email to reset your password.
      </p>

      {% form 'recover_customer_password' %}
        {% if form.errors %}
          <div style="background: #FDF2F2; border: 1px solid #F8B4B4; color: #9B1C1C; font-size: 13px; padding: 10px 14px; border-radius: 4px; margin-bottom: 16px;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        {% if form.posted_successfully? %}
          <div style="background: #F0FDF4; border: 1px solid #BBF7D0; color: #166534; font-size: 13px; padding: 10px 14px; border-radius: 4px; margin-bottom: 16px; text-align: center;">
            We've sent you an email with a link to update your password.
          </div>
        {% endif %}

        <div style="margin-bottom: 18px;">
          <label for="RecoverEmail" style="display: block; font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; color: var(--ink, #2C2623);">
            Email Address
          </label>
          <input type="email" name="email" id="RecoverEmail" placeholder="yourname@example.com" required style="width: 100%; padding: 12px 14px; border: 1px solid var(--line, #D6CDBB); border-radius: 4px; background: var(--white, #FFF); font-family: var(--font-sans, sans-serif); font-size: 14px; color: var(--ink, #2C2623); outline: none; box-sizing: border-box;">
        </div>

        <button type="submit" class="btn btn--primary" style="width: 100%; padding: 13px 20px; font-size: 12.5px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--copper-deep, #8A4324); color: #FFF; border: none; border-radius: 4px; cursor: pointer; transition: background 0.3s ease;">
          Submit
        </button>

        <div style="text-align: center; margin-top: 14px;">
          <button type="button" id="HideRecoverPasswordBtn" style="background: none; border: none; font-size: 13px; color: var(--taupe, #706862); text-decoration: underline; cursor: pointer;">
            Cancel & Return to Login
          </button>
        </div>
      {% endform %}
    </div>

    <!-- Main Login Form -->
    <div id="CustomerLoginForm" style="background: var(--linen-soft, #F7F3ED); border: 1px solid var(--line, #E5DEC9); border-radius: 8px; padding: 32px 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
      
      <div style="text-align: center; margin-bottom: 24px;">
        <h2 style="font-family: var(--font-display, serif); font-size: 26px; font-weight: 500; color: var(--ink, #2C2623); margin-bottom: 4px;">
          Sign In
        </h2>
        <span style="font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--copper-deep, #8A4324);">
          Amoraki Account
        </span>
      </div>

      {% form 'customer_login' %}
        {% if form.errors %}
          <div style="background: #FDF2F2; border: 1px solid #F8B4B4; color: #9B1C1C; font-size: 13px; padding: 10px 14px; border-radius: 4px; margin-bottom: 18px;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div style="margin-bottom: 18px;">
          <label for="CustomerEmail" style="display: block; font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; color: var(--ink, #2C2623);">
            Email Address
          </label>
          <input type="email" name="customer[email]" id="CustomerEmail" placeholder="yourname@example.com" autocomplete="email" required style="width: 100%; padding: 12px 14px; border: 1px solid var(--line, #D6CDBB); border-radius: 4px; background: var(--white, #FFF); font-family: var(--font-sans, sans-serif); font-size: 14px; color: var(--ink, #2C2623); outline: none; box-sizing: border-box;">
        </div>

        {% if form.password_needed %}
          <div style="margin-bottom: 18px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <label for="CustomerPassword" style="font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink, #2C2623);">
                Password
              </label>
              <button type="button" id="ShowRecoverPasswordBtn" style="background: none; border: none; font-size: 12px; color: var(--copper-deep, #8A4324); text-decoration: underline; cursor: pointer; padding: 0;">
                Forgot password?
              </button>
            </div>
            <input type="password" name="customer[password]" id="CustomerPassword" placeholder="••••••••" autocomplete="current-password" required style="width: 100%; padding: 12px 14px; border: 1px solid var(--line, #D6CDBB); border-radius: 4px; background: var(--white, #FFF); font-family: var(--font-sans, sans-serif); font-size: 14px; color: var(--ink, #2C2623); outline: none; box-sizing: border-box;">
          </div>
        {% endif %}

        <button type="submit" class="btn btn--primary" style="width: 100%; padding: 14px 20px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--copper-deep, #8A4324); color: #FFF; border: none; border-radius: 4px; cursor: pointer; transition: background 0.3s ease; margin-top: 8px;">
          Sign In &rarr;
        </button>
      {% endform %}

      <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line, #E5DEC9); text-align: center;">
        <p style="font-size: 13.5px; color: var(--taupe, #706862); margin-bottom: 12px;">
          Don't have an account yet?
        </p>
        <a href="{{ routes.account_register_url }}" class="btn" style="display: block; width: 100%; padding: 12px 20px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; background: transparent; border: 1px solid var(--line, #C4B9A7); color: var(--ink, #2C2623); border-radius: 4px; text-decoration: none; text-align: center; box-sizing: border-box;">
          Create an Account
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const showRecoverBtn = document.getElementById('ShowRecoverPasswordBtn');
    const hideRecoverBtn = document.getElementById('HideRecoverPasswordBtn');
    const recoverForm = document.getElementById('RecoverPasswordForm');
    const loginForm = document.getElementById('CustomerLoginForm');

    if (showRecoverBtn && recoverForm && loginForm) {
      showRecoverBtn.addEventListener('click', function(e) {
        e.preventDefault();
        loginForm.style.display = 'none';
        recoverForm.style.display = 'block';
      });
    }

    if (hideRecoverBtn && recoverForm && loginForm) {
      hideRecoverBtn.addEventListener('click', function(e) {
        e.preventDefault();
        recoverForm.style.display = 'none';
        loginForm.style.display = 'block';
      });
    }

    if (window.location.hash === '#recover') {
      if (loginForm && recoverForm) {
        loginForm.style.display = 'none';
        recoverForm.style.display = 'block';
      }
    }
  });
</script>

{% schema %}
{
  "name": "Main Login",
  "settings": []
}
{% endschema %}
