            <p style="margin-bottom: 16px;">Questions about the Terms of Service should be sent to us at <a href="mailto:reachmitikamalhotra@gmail.com" style="color: var(--copper); font-weight: 500;">reachmitikamalhotra@gmail.com</a>.</p>
          </div>
        {% endif %}
      {% endif %}

    </div>
