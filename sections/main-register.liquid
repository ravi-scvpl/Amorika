{% comment %}
  Main Registration Section - Moments By Amoraki
  Luxury minimal customer registration template (/account/register)
{% endcomment %}

<div class="register-page-hero" style="background: var(--linen-soft, #F7F3ED); padding: clamp(3.5rem, 6vw, 5rem) 0 2.5rem; border-bottom: 1px solid var(--line, #E5DEC9); text-align: center;">
  <div class="wrap" style="max-width: 600px;">
    <h1 class="h2" style="font-family: var(--font-display, 'Cormorant Garamond', serif); font-size: clamp(30px, 4.5vw, 44px); font-weight: 500; margin-bottom: 8px; color: var(--ink, #2C2623);">
      Create Your Account
    </h1>
    <p style="font-size: 14.5px; color: var(--taupe, #706862); max-width: 440px; margin: 0 auto; line-height: 1.5;">
      Join Amoraki to enjoy seamless ordering, saved preferences, and bespoke curations.
    </p>
  </div>
</div>

<section class="register-section" style="padding: clamp(3rem, 5vw, 4.5rem) 0; background: var(--white, #FFF);">
  <div class="wrap" style="max-width: 460px; margin: 0 auto;">

    <div style="background: var(--linen-soft, #F7F3ED); border: 1px solid var(--line, #E5DEC9); border-radius: 8px; padding: 32px 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
      
      <div style="text-align: center; margin-bottom: 24px;">
        <h2 style="font-family: var(--font-display, serif); font-size: 26px; font-weight: 500; color: var(--ink, #2C2623); margin-bottom: 4px;">
          Register
        </h2>
        <span style="font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--copper-deep, #8A4324);">
          New Customer
        </span>
      </div>

      {% form 'create_customer' %}
        {% if form.errors %}
          <div style="background: #FDF2F2; border: 1px solid #F8B4B4; color: #9B1C1C; font-size: 13px; padding: 10px 14px; border-radius: 4px; margin-bottom: 18px;">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div style="margin-bottom: 16px;">
          <label for="FirstName" style="display: block; font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; color: var(--ink, #2C2623);">
            First Name
          </label>
          <input type="text" name="customer[first_name]" id="FirstName" placeholder="First Name" autocomplete="given-name" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line, #D6CDBB); border-radius: 4px; background: var(--white, #FFF); font-family: var(--font-sans, sans-serif); font-size: 14px; color: var(--ink, #2C2623); outline: none; box-sizing: border-box;">
        </div>

        <div style="margin-bottom: 16px;">
          <label for="LastName" style="display: block; font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; color: var(--ink, #2C2623);">
            Last Name
          </label>
          <input type="text" name="customer[last_name]" id="LastName" placeholder="Last Name" autocomplete="family-name" style="width: 100%; padding: 12px 14px; border: 1px solid var(--line, #D6CDBB); border-radius: 4px; background: var(--white, #FFF); font-family: var(--font-sans, sans-serif); font-size: 14px; color: var(--ink, #2C2623); outline: none; box-sizing: border-box;">
        </div>

        <div style="margin-bottom: 16px;">
          <label for="RegisterEmail" style="display: block; font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; color: var(--ink, #2C2623);">
            Email Address
          </label>
          <input type="email" name="customer[email]" id="RegisterEmail" placeholder="yourname@example.com" autocomplete="email" required style="width: 100%; padding: 12px 14px; border: 1px solid var(--line, #D6CDBB); border-radius: 4px; background: var(--white, #FFF); font-family: var(--font-sans, sans-serif); font-size: 14px; color: var(--ink, #2C2623); outline: none; box-sizing: border-box;">
        </div>

        <div style="margin-bottom: 22px;">
          <label for="RegisterPassword" style="display: block; font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; color: var(--ink, #2C2623);">
            Password
          </label>
          <input type="password" name="customer[password]" id="RegisterPassword" placeholder="Create a password" autocomplete="new-password" required style="width: 100%; padding: 12px 14px; border: 1px solid var(--line, #D6CDBB); border-radius: 4px; background: var(--white, #FFF); font-family: var(--font-sans, sans-serif); font-size: 14px; color: var(--ink, #2C2623); outline: none; box-sizing: border-box;">
        </div>

        <button type="submit" class="btn btn--primary" style="width: 100%; padding: 14px 20px; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; background: var(--copper-deep, #8A4324); color: #FFF; border: none; border-radius: 4px; cursor: pointer; transition: background 0.3s ease;">
          Create Account &rarr;
        </button>
      {% endform %}

      <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line, #E5DEC9); text-align: center;">
        <p style="font-size: 13.5px; color: var(--taupe, #706862); margin-bottom: 12px;">
          Already have an account?
        </p>
        <a href="{{ routes.account_login_url }}" class="btn" style="display: block; width: 100%; padding: 12px 20px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; background: transparent; border: 1px solid var(--line, #C4B9A7); color: var(--ink, #2C2623); border-radius: 4px; text-decoration: none; text-align: center; box-sizing: border-box;">
          Sign In Instead
        </a>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Main Register",
  "settings": []
}
{% endschema %}
