{% comment %}
  RTB Strip / Moments Pillars
  Fully customizable via Shopify Customizer with repeatable pillar blocks.
{% endcomment %}

<div class="rtb">
  <div class="wrap">
    {% if section.blocks.size > 0 %}
      <style>
        .rtb .wrap {
          display: grid;
          grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
          gap: 0;
        }
        .rtb-icon img.rtb-custom-icon {
          width: 32px;
          height: 32px;
          object-fit: contain;
          display: block;
        }
        @media(max-width:768px) {
          .rtb .wrap {
            grid-template-columns: 1fr;
          }
        }
      </style>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="rtb-item" {{ block.shopify_attributes }}>
          <div class="rtb-icon">
            {% if block.settings.custom_icon != blank %}
              {{ block.settings.custom_icon | image_url: width: 80 | image_tag: loading: 'lazy', class: 'rtb-custom-icon', alt: block.settings.title }}
            {% elsif block.settings.svg_code != blank %}
              {{ block.settings.svg_code }}
            {% else %}
              {% case forloop.index %}
                {% when 1 %}
                  <img src="{{ 'Thoughtfully Chosen.png' | asset_url }}" alt="{{ block.settings.title }}" class="rtb-custom-icon" loading="lazy">
                {% when 2 %}
                  <img src="{{ 'Made slowly (1).png' | asset_url }}" alt="{{ block.settings.title }}" class="rtb-custom-icon" loading="lazy">
                {% else %}
                  <img src="{{ 'Wrapped with intention.png' | asset_url }}" alt="{{ block.settings.title }}" class="rtb-custom-icon" loading="lazy">
              {% endcase %}
            {% endif %}
          </div>
          <div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Default Fallback Pillars (Exact preview.html) -->
      <div class="rtb-item">
        <div class="rtb-icon">
          <img src="{{ 'Thoughtfully Chosen.png' | asset_url }}" alt="Thoughtfully Chosen" class="rtb-custom-icon" loading="lazy">
        </div>
        <div>
          <h3>Thoughtfully Chosen</h3>
          <p>Every object earns its place inside the hamper.</p>
        </div>
      </div>

      <div class="rtb-item">
        <div class="rtb-icon">
          <img src="{{ 'Made slowly (1).png' | asset_url }}" alt="Made Slowly" class="rtb-custom-icon" loading="lazy">
        </div>
        <div>
          <h3>Made Slowly</h3>
          <p>Hand-poured, hand-hammered, hand-tied. Small batches, not mass production.</p>
        </div>
      </div>

      <div class="rtb-item">
        <div class="rtb-icon">
          <img src="{{ 'Wrapped with intention.png' | asset_url }}" alt="Wrapped With Intention" class="rtb-custom-icon" loading="lazy">
        </div>
        <div>
          <h3>Wrapped With Intention</h3>
          <p>Presentation is part of the gift, not packaging as an afterthought.</p>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Moments Pillars",
  "settings": [],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image"
        },
        {
          "type": "html",
          "id": "svg_code",
          "label": "Custom SVG Code",
          "info": "Optional: Paste custom SVG code if image is not used"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "Thoughtfully Chosen"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Pillar Description",
          "default": "Every object earns its place inside the hamper."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Moments Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Thoughtfully Chosen",
            "description": "Every object earns its place inside the hamper."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Made Slowly",
            "description": "Hand-poured, hand-hammered, hand-tied. Small batches, not mass production."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Wrapped With Intention",
            "description": "Presentation is part of the gift, not packaging as an afterthought."
          }
        }
      ]
    }
  ]
}
{% endschema %}
