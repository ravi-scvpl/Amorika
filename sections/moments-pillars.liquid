{% comment %}
  RTB Strip / Moments Pillars (Exact Match preview.html)
{% endcomment %}

<div class="rtb">
  <div class="wrap">
    <div class="rtb-item">
      <div class="rtb-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 3" />
        </svg>
      </div>
      <div>
        <h3>{{ section.settings.pillar1_title | default: 'Thoughtfully Chosen' }}</h3>
        <p>{{ section.settings.pillar1_desc | default: 'Every object earns its place inside the hamper.' }}</p>
      </div>
    </div>

    <div class="rtb-item">
      <div class="rtb-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
        </svg>
      </div>
      <div>
        <h3>{{ section.settings.pillar2_title | default: 'Made Slowly' }}</h3>
        <p>{{ section.settings.pillar2_desc | default: 'Hand-poured, hand-hammered, hand-tied. Small batches, not mass production.' }}</p>
      </div>
    </div>

    <div class="rtb-item">
      <div class="rtb-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="8" width="18" height="13" rx="2" />
          <path d="M12 8V3M8 3h8" />
        </svg>
      </div>
      <div>
        <h3>{{ section.settings.pillar3_title | default: 'Wrapped With Intention' }}</h3>
        <p>{{ section.settings.pillar3_desc | default: 'Presentation is part of the gift, not packaging as an afterthought.' }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Moments Pillars",
  "settings": [
    {
      "type": "text",
      "id": "pillar1_title",
      "label": "Pillar 1 Title",
      "default": "Thoughtfully Chosen"
    },
    {
      "type": "textarea",
      "id": "pillar1_desc",
      "label": "Pillar 1 Description",
      "default": "Every object earns its place inside the hamper."
    },
    {
      "type": "text",
      "id": "pillar2_title",
      "label": "Pillar 2 Title",
      "default": "Made Slowly"
    },
    {
      "type": "textarea",
      "id": "pillar2_desc",
      "label": "Pillar 2 Description",
      "default": "Hand-poured, hand-hammered, hand-tied. Small batches, not mass production."
    },
    {
      "type": "text",
      "id": "pillar3_title",
      "label": "Pillar 3 Title",
      "default": "Wrapped With Intention"
    },
    {
      "type": "textarea",
      "id": "pillar3_desc",
      "label": "Pillar 3 Description",
      "default": "Presentation is part of the gift, not packaging as an afterthought."
    }
  ],
  "presets": [
    {
      "name": "Moments Pillars"
    }
  ]
}
{% endschema %}
