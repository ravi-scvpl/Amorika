{% comment %}
  Upcoming Collections Section - Moments By Amoraki
  "On the Horizon" with Moment of Play & Moment of Synergy preview cards
{% endcomment %}

<section class="upcoming-section" id="upcoming-collections" style="padding: var(--section-pad-y) 0; background: var(--color-bg);">
  <div class="container">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 3.5rem;">
      <span class="eyebrow">NEXT CATEGORIES</span>
      <h2 class="h2">{{ section.settings.heading | default: 'On the Horizon' }}</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem; max-width: 960px; margin: 0 auto;">
      <!-- Card 1: Moment of Play -->
      <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 3rem 2.5rem; text-align: center; box-shadow: var(--shadow-subtle);">
        <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent); font-weight: 600;">COMING SOON</span>
        <h3 style="font-family: var(--font-serif); font-size: 2rem; margin: 0.75rem 0 1.25rem;">Moment of Play</h3>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin-bottom: 2rem; max-width: 320px; margin-left: auto; margin-right: auto;">
          Curated rituals designed to spark joyful discovery, lighthearted togetherness, and creative pause.
        </p>
        <button type="button" class="btn btn--outline js-notify-me" onclick="showToast('You will be notified when Moment of Play launches!');">
          Notify Me
        </button>
      </div>

      <!-- Card 2: Moment of Synergy -->
      <div style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 3rem 2.5rem; text-align: center; box-shadow: var(--shadow-subtle);">
        <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-accent); font-weight: 600;">COMING SOON</span>
        <h3 style="font-family: var(--font-serif); font-size: 2rem; margin: 0.75rem 0 1.25rem;">Moment of Synergy</h3>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin-bottom: 2rem; max-width: 320px; margin-left: auto; margin-right: auto;">
          Thoughtful experiences created for collaborative bonds, shared milestones, and meaningful harmony.
        </p>
        <button type="button" class="btn btn--outline js-notify-me" onclick="showToast('You will be notified when Moment of Synergy launches!');">
          Notify Me
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Upcoming Collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "On the Horizon"
    }
  ],
  "presets": [
    {
      "name": "Upcoming Collections"
    }
  ]
}
{% endschema %}
