{% comment %}
  Recipient and Buyer Custom Fields Snippet - Amoraki
  Step 06: Collect Buyer and Recipient Information
{% endcomment %}

<div class="cart-recipient-fields" style="background: var(--white); border: 1px solid var(--line); border-radius: 6px; padding: 20px; margin-bottom: 24px;">
  <h4 style="font-family: var(--font-display); font-size: 18px; font-weight: 500; color: var(--ink); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--line);">
    Where should we send it?
  </h4>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
    <div>
      <label for="BuyerFullName" style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; color: var(--taupe);">Buyer Full Name *</label>
      <input type="text" id="BuyerFullName" name="attributes[Buyer Full Name]" required placeholder="Your full name" style="width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 4px; font-size: 13px;">
    </div>
    <div>
      <label for="BuyerMobile" style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; color: var(--taupe);">Buyer Mobile *</label>
      <input type="tel" id="BuyerMobile" name="attributes[Buyer Mobile Number]" required placeholder="Your phone number" style="width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 4px; font-size: 13px;">
    </div>
  </div>

  <div style="margin-bottom: 16px;">
    <label for="BuyerEmail" style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; color: var(--taupe);">Buyer Email Address *</label>
    <input type="email" id="BuyerEmail" name="attributes[Buyer Email Address]" required placeholder="your.email@domain.com" style="width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 4px; font-size: 13px;">
  </div>

  <div style="margin-top: 20px; padding-top: 16px; border-top: 1px dashed var(--line);">
    <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; color: var(--ink); cursor: pointer; margin-bottom: 16px;">
      <input type="checkbox" id="DifferentRecipientToggle" name="attributes[Billing and shipping details are different]" value="Yes" style="accent-color: var(--copper-deep);">
      Billing and shipping details are different.
    </label>

    <div id="RecipientFieldsWrapper" style="display: none; background: var(--linen-soft); padding: 16px; border-radius: 4px; border: 1px solid var(--line);">
      <h5 style="font-family: var(--font-display); font-size: 16px; font-weight: 500; color: var(--ink); margin-bottom: 12px;">Recipient Details</h5>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
        <div>
          <label for="RecipientFullName" style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; color: var(--taupe);">Recipient Full Name</label>
          <input type="text" id="RecipientFullName" name="attributes[Recipient Full Name]" placeholder="Recipient's name" style="width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 4px; font-size: 13px; background: var(--white);">
        </div>
        <div>
          <label for="RecipientMobile" style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; color: var(--taupe);">Recipient Mobile</label>
          <input type="tel" id="RecipientMobile" name="attributes[Recipient Mobile Number]" placeholder="Recipient's phone" style="width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 4px; font-size: 13px; background: var(--white);">
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('DifferentRecipientToggle');
    const wrapper = document.getElementById('RecipientFieldsWrapper');
    if (toggle && wrapper) {
      toggle.addEventListener('change', function() {
        wrapper.style.display = this.checked ? 'block' : 'none';
      });
    }
  });
</script>
