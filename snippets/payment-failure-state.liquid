{% comment %}
  Payment Failure & Retry Messaging Snippet - Amoraki
  Step 10: Payment Failed Screen Copy & Actions
{% endcomment %}

<div class="payment-failed-state" style="max-width: 520px; margin: 3rem auto; text-align: center; background: #FFF9F8; border: 1px solid #F5D3CE; border-radius: 8px; padding: 36px 24px;">
  
  <div style="font-size: 32px; margin-bottom: 12px;">⏳</div>

  <h2 style="font-family: var(--font-display, 'Cormorant Garamond', serif); font-size: 28px; font-weight: 500; color: var(--ink, #2C2623); margin-bottom: 8px;">
    A little pause. Nothing lost.
  </h2>

  <p style="font-size: 15px; color: var(--taupe, #59524C); line-height: 1.6; margin-bottom: 24px;">
    Your payment didn’t go through. Your order is still waiting.
  </p>

  <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
    <a href="/checkout" class="btn btn--primary" style="padding: 12px 24px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; background: var(--copper-deep, #8A4324); color: #FFF; text-decoration: none; border-radius: 4px;">
      Retry Payment
    </a>
    <a href="/checkout?step=payment_method" class="btn" style="padding: 12px 24px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; background: transparent; border: 1px solid var(--line, #C4B9A7); color: var(--ink, #2C2623); text-decoration: none; border-radius: 4px;">
      Try Another Method
    </a>
  </div>

</div>
